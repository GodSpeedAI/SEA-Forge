            "mimeType": "text/css",
            "size": 2906,
            "text": ".gs-r-md-root{display:flex;height:100%;background:var(--dock-bg);color:var(--dock-ink);overflow-y:auto;overflow-x:hidden}.gs-r-md-content{flex:1;max-width:68ch;padding:24px 20px;font-family:var(--font-sans);font-size:14px;line-height:1.55}.gs-r-md-h1{margin:32px 0 16px;font-size:28px;font-weight:600;line-height:1.2;cursor:pointer;transition:background .1s ease-out;padding:8px 12px;border-radius:0}.gs-r-md-h1[data-selected=true]{background:#3e8bf026}.gs-r-md-h2{margin:24px 0 12px;font-size:22px;font-weight:600;line-height:1.25;cursor:pointer;transition:background .1s ease-out;padding:6px 12px;border-radius:0}.gs-r-md-h2[data-selected=true]{background:#3e8bf026}.gs-r-md-h3{margin:16px 0 8px;font-size:18px;font-weight:600;line-height:1.3;cursor:pointer;transition:background .1s ease-out;padding:4px 12px;border-radius:0}.gs-r-md-h3[data-selected=true]{background:#3e8bf026}.gs-r-md-p{margin:12px 0;cursor:pointer;transition:background .1s ease-out;padding:2px 12px;border-radius:0}.gs-r-md-p[data-selected=true]{background:#3e8bf026}.gs-r-md-list{margin:12px 0;padding-left:24px;list-style:disc;cursor:pointer;transition:background .1s ease-out;border-radius:0}.gs-r-md-list[data-selected=true]{background:#3e8bf026;padding:2px 12px 2px 24px}.gs-r-md-list li{margin:4px 0;cursor:pointer}.gs-r-md-quote{margin:12px 0;padding:8px 12px 8px 16px;border-left:4px solid var(--dock-ink-2);color:var(--dock-ink-2);font-style:italic;cursor:pointer;transition:all .1s ease-out;border-radius:0}.gs-r-md-quote[data-selected=true]{background:#3e8bf026;color:var(--dock-ink);border-left-color:var(--tone-progress)}.gs-r-md-code{margin:12px 0;padding:12px;background:#0000004d;border:1px solid var(--dock-line);font-family:var(--font-mono);font-size:12px;line-height:1.4;overflow-x:auto;cursor:pointer;transition:background .1s ease-out;border-radius:0}.gs-r-md-code[data-selected=true]{background:#3e8bf026;border-color:var(--tone-progress)}.gs-r-md-code code{display:block;white-space:pre-wrap;word-break:break-word;font-variant-numeric:tabular-nums}.gs-r-md-content mark{background:#ffffff4d;padding:1px 2px;border-radius:0;color:inherit}.gs-r-md-quote mark{background:#ffffff40}.gs-r-md-code mark{background:#ffffff4d}\n"
