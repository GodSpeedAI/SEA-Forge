# SHACL Shapes
sea:FlowShape a sh:NodeShape ;
    sh:targetClass sea:Flow ;
    sh:property [
        sh:path sea:quantity ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
    ] ;
    sh:property [
        sh:path sea:hasResource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sea:from ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sea:to ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

sea:EntityShape a sh:NodeShape ;
    sh:targetClass sea:Entity ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

