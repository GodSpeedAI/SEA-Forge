    SADAPT["OpenAiCompatibleProvider (HTTP /v1/chat/completions)<br/>AnthropicProvider<br/>NetworkPolicy: production requires HTTPS"]
  end

  subgraph COMPOSE["DETERMINISTIC COMPOSITION — exists twice"]
