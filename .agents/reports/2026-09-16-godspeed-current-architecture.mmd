  end

  SFAB["sea-forge-authority (AUTHORITY)<br/>PolicyAuthorityEngine, PolicyAuthorityBundle<br/>Verdict{Allow,Deny,Escalate}, NormalizedDisposition{+Boundary,Degraded}<br/>Determinism{policy_bundle_hash, action_request_hash, identity_binding_hash}"]

