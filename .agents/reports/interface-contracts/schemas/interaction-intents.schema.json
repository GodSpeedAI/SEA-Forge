{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godspeed.ai/schemas/interaction-intents.schema.json",
  "title": "InteractionIntent",
  "description": "Typed interaction intent dispatched from the Cognitive Environment to the Go System Front End.",
  "type": "object",
  "required": [
    "intent_id",
    "kind",
    "action_name",
    "target_object_id",
    "case_id",
    "client_cursor",
    "actor"
  ],
  "properties": {
    "intent_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique client-generated idempotency key."
    },
    "kind": {
      "type": "string",
      "enum": ["REACT_LOCAL", "BACKEND_INFORMATION", "CONSEQUENTIAL_CASE"]
    },
    "action_name": {
      "type": "string",
      "enum": [
        "SELECT_OBJECT",
        "NAVIGATE_CAMERA",
        "FILTER_VIEW",
        "RESOLVE_SOURCE",
        "REQUEST_DEEP_PROJECTION",
        "REQUEST_HISTORY_SCRUB",
        "BEGIN_WORK",
        "APPROVE_HUMAN_TASK",
        "REJECT_HUMAN_TASK",
        "ADD_DISCRETIONARY_WORK",
        "REOPEN_WORK",
        "ESCALATE_OR_OVERRIDE",
        "OPEN_ARTIFACT",
        "EXPORT_AUDIT_BUNDLE",
        "RESUME_LIVE_STREAM"
      ]
    },
    "target_object_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string",
      "pattern": "^case-[a-z0-9_.-]+$"
    },
    "client_cursor": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{10}$",
      "description": "The monotonic cursor of the snapshot the user was looking at when they took the action."
    },
    "actor": {
      "type": "object",
      "required": ["actor_id", "role"],
      "properties": {
        "actor_id": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "justification": {
      "type": "string",
      "description": "Required when invoking override or emergency actions."
    }
  }
}
