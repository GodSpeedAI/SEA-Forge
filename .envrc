# Shell-SPEC §8.2 activation layer.
# Loads the active encrypted profile when an age key is present; otherwise
# emits a redacted warning and leaves secret variables unset so offline gates
# remain available. MUST NOT fail when no key is present.

# Default the age key location if the operator has not set it.
if [ -z "${SOPS_AGE_KEY_FILE:-}" ]; then
  if [ -f "$HOME/.config/sops/key.txt" ]; then
    export SOPS_AGE_KEY_FILE="$HOME/.config/sops/key.txt"
  elif [ -f "$HOME/.config/sops/age/keys.txt" ]; then
    export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
  fi
fi

# SEA_ENV selects dev | test | ci (Shell-SPEC §8.1); defaults to dev.
export SEA_ENV="${SEA_ENV:-dev}"

# Standard tool-owned variables MAY retain their standard names (§8.1).
export RUST_LOG="${RUST_LOG:-sea_forge=info}"

load_sops_env() {
  local profile="$SEA_ENV"
  local enc="$PWD/secrets/${profile}.enc.env"
  if [ ! -f "$enc" ]; then
    log_status "sea-forge: no encrypted profile for '$profile' — offline mode"
    return 0
  fi
  if [ -z "${SOPS_AGE_KEY_FILE:-}" ] || [ ! -f "${SOPS_AGE_KEY_FILE}" ]; then
    log_status "sea-forge: no age key — secrets not loaded (offline mode)"
    return 0
  fi
  if ! has sops; then
    log_error "sea-forge: sops not on PATH — secrets not loaded"
    return 0
  fi
  local tmp
  tmp="$(mktemp)"
  chmod 600 "$tmp"
  if sops -d "$enc" >"$tmp" 2>/dev/null; then
    set -a
    # shellcheck disable=SC1090
    . "$tmp"
    set +a
    rm -f "$tmp"
    log_status "sea-forge: loaded secrets for profile '$profile'"
  else
    rm -f "$tmp"
    # Do not fail direnv: offline gates must remain available (§8.2, §9).
    log_error "sea-forge: failed to decrypt '$enc' — secrets not loaded"
  fi
}

load_sops_env

# Reload when the encrypted profile or age key changes.
if [ -f "secrets/${SEA_ENV}.enc.env" ]; then
  watch_file "secrets/${SEA_ENV}.enc.env"
fi
if [ -n "${SOPS_AGE_KEY_FILE:-}" ] && [ -f "${SOPS_AGE_KEY_FILE}" ]; then
  watch_file "${SOPS_AGE_KEY_FILE}"
fi

