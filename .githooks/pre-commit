#!/usr/bin/env bash
# Pre-commit hook. Delegates the actual checks to `just pre-commit` so the
# contract between local and CI is the recipe, not the hook. Keep this script
# dependency-free POSIX shell plus bash; the recipes own the real work.
#
# Bypass: `git commit --no-verify`. Note this only skips local checks; the
# GitHub Actions required checks still gate the pull request regardless.
set -euo pipefail

# Only run when there are staged changes worth checking.
if [ -z "$(git diff --cached --name-only)" ]; then
    exit 0
fi

# Toolchain choice (pinned devbox when it starts, host otherwise, or forced
# with SEA_FORGE_HOOK_TOOLCHAIN) lives in run-recipe, shared by both hooks.
exec "$(git rev-parse --show-toplevel)/.githooks/run-recipe" pre-commit pre-commit
