#!/usr/bin/env bash
# Pre-push hook. Delegates to `just pre-push` (context + fmt; seconds). The
# full sweep runs on GitHub (`CI / gate`); reproduce it locally with `just ci`
# or one job with `just ci-job <job>`.
#
# Bypass: `git push --no-verify`. GitHub's required `CI / gate` check still
# applies to the pull request.
set -euo pipefail

# Read the refs git is pushing; refuse only on pushes to main.
zero="0000000000000000000000000000000000000000"
while read -r _local _remote _sha_local _sha_remote; do
    if [ "$_sha_remote" = "$zero" ] && [ "$_local" = "refs/heads/main" ]; then
        echo "pre-push: refusing to create a remote main branch" >&2
        exit 1
    fi
done

# Toolchain choice (pinned devbox when it starts, host otherwise, or forced
# with SEA_FORGE_HOOK_TOOLCHAIN) lives in run-recipe, shared by both hooks.
exec "$(git rev-parse --show-toplevel)/.githooks/run-recipe" pre-push pre-push
