{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "crates/sea-forge-agent/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-artifact-ip/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-authority/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-capability/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-case-runner/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-cell/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-cli/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-domain/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-domainforge/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-evidence/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-extension/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-ledger/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-planner/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-realitytrace/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-runtime/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-sandbox/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-self-model/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-server/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-settlement/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-spec-pipeline/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-thoth/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "crates/sea-forge-trace/Cargo.toml", "jsonpath": "$..[?(@.path && @.version)].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(!@.source)].version" }
      ],
      "changelog-types": [
        { "type": "feat",     "section": "Features" },
        { "type": "fix",      "section": "Bug Fixes" },
        { "type": "perf",     "section": "Performance" },
        { "type": "refactor", "section": "Refactoring", "hidden": false },
        { "type": "revert",   "section": "Reverts" },
        { "type": "docs",     "section": "Documentation", "hidden": true },
        { "type": "test",     "section": "Tests",         "hidden": true },
        { "type": "build",    "section": "Build",         "hidden": true },
        { "type": "ci",       "section": "CI",            "hidden": true },
        { "type": "chore",    "section": "Miscellaneous", "hidden": true }
      ],
      "tag-separator": "",
      "include-component-in-tag": false,
      "skip-github-release": false,
      "draft": false,
      "prerelease": false
    }
  }
}
