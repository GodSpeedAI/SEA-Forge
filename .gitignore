# Rust build output
/target/

# Windows Mark-of-the-Web / NTFS alternate-data-stream metadata
# (created when files are copied from Windows; never commit these)
*:Zone.Identifier

# Devbox / Nix
/.devbox/
/.direnv/

# direnv
/.envrc.local
# .envrc itself IS tracked (Shell-SPEC Appendix A); re-include despite global ignores.
!/.envrc

# Generated bootstrap evidence (Shell-SPEC §3.1)
/target/bootstrap-evidence/

# SEA Forge runtime output (never commit runtime records)
/.sea-forge/
/.worktrees/

# Understand-Anything knowledge graph (rebuildable projection; regenerate via the understand skill)
/.ua/

# Local agent-tool config/state (transient, per-machine)
/.omc/
/.claude/
/.codex/
/.opencode/
/.entire/

# Local secret artifacts: only *.enc.env may be tracked under secrets/
/secrets/*.env
!/secrets/*.enc.env
/secrets/.decrypted/

# Editor / OS noise
*.swp
.DS_Store


.tmp/

# Tauri sidecar staging: built by `just workbench-sidecar`, never committed.
workbench/apps/desktop/src-tauri/binaries/

# Pinned local desktop-test tooling. The reproducible version and setup
# instructions live in scripts/workbench-e2e-real.sh; the executable itself is
# a machine-local build artifact.
workbench/.tools/
