@namespace "sea_forge.interaction"
@version "0.1.0"

// Explanatory index for the "Canonical journey instances", "Canonical journey
// transition states", and "Canonical journey transformation flows" sections
// in interaction-model.sea. Those sections define CJ01-CJ12, their unique
// entry and completion states, and one InteractionProgress flow per journey.
