// ---------------------------------------------------------------------------
// Operations: Navigation steps and delivery activities
//
// Each is one inbound operation with an operation_trace evidence obligation.
// Bound policies are Constraint policies over the operation input record, the
// only scope DomainForge 0.21.2 admits (APP007); `postcondition` and
// `invariant` enforcement points are rejected, so no policy uses them.
// ---------------------------------------------------------------------------

operation case_open_or_resume {
    intent "retrieve a Field Case from the authoritative case record so it can be continued without the previous worker's memory"
    direction inbound
    actor FDE
    access public
    input CaseOpenOrResumeInput
    output CaseOpenOrResumeOutput
    state FieldCase
    effect reads FieldCase
    transaction read_only
    failure case_open_or_resume_invalid_input for input_validation "case_id is empty"
    failure case_open_or_resume_not_found for missing_state "no such case record"
    idempotency inherent
    concurrency read_snapshot
    evidence operation_trace
    lifecycle synchronous_request_response
}

operation nav_listen {
    intent "read the case, world_ref, checkpoint, decision history and reliable observations before choosing the next move"
    direction inbound
    actor FDE
    access public
    input NavListenInput
    output NavListenOutput
    state FieldCase
    effect reads FieldCase
    transaction read_only
    failure nav_listen_invalid_input for input_validation "case_id is empty"
    failure nav_listen_not_found for missing_state "no such case record"
    idempotency inherent
    concurrency read_snapshot
    evidence operation_trace
    lifecycle synchronous_request_response
}

operation nav_aim {
    intent "fix and freeze the episode reference and its hash before execution for an evaluated path"
    direction inbound
    actor FDE
    access policy_governed by episode_key_unique at precondition fails with nav_aim_policy_denied, executor_never_rewrites_criteria at precondition fails with nav_aim_policy_denied
    input NavAimInput
    output NavAimOutput
    state Episode
    effect creates Episode
    transaction single_aggregate
    failure nav_aim_invalid_input for input_validation "input failed record validation"
    failure nav_aim_policy_denied for policy "a bound precondition policy does not hold"
    failure nav_aim_conflict for idempotency_conflict, concurrency_conflict "the key already exists with different content"
    idempotency keyed_by episode_ref
    concurrency unique_key episode_ref
    evidence operation_trace
    lifecycle synchronous_request_response
}

operation nav_move {
    intent "bind an assignment to case, world, criterion, authority and budget and record the delegated move"
    direction inbound
    actor FDE
    access policy_governed by freeze_before_move at precondition fails with nav_move_policy_denied, authorize_consequential_action at precondition fails with nav_move_policy_denied, criteria_change_needs_new_version at precondition fails with nav_move_policy_denied
    input NavMoveInput
    output NavMoveOutput
    state Assignment
    effect creates Assignment
    transaction single_aggregate
    failure nav_move_invalid_input for input_validation "input failed record validation"
    failure nav_move_policy_denied for policy "a bound precondition policy does not hold"
    failure nav_move_conflict for idempotency_conflict, concurrency_conflict "the key already exists with different content"
    idempotency keyed_by assignment_id
    concurrency unique_key assignment_id
    evidence operation_trace
    lifecycle synchronous_request_response
}

operation nav_claim {
    intent "record the independent epistemic settlement of a frozen expectation as S, F, U or C with reliability and source independence"
    direction inbound
    actor IndependentVerifier
    access policy_governed by no_self_settlement at precondition fails with nav_claim_policy_denied, fresh_verifier_in_single_person_case at precondition fails with nav_claim_policy_denied
    input NavClaimInput
    output NavClaimOutput
    state EvidenceSettlement
    effect creates EvidenceSettlement
    transaction single_aggregate
    failure nav_claim_invalid_input for input_validation "input failed record validation"
    failure nav_claim_policy_denied for policy "a bound precondition policy does not hold"
    failure nav_claim_conflict for idempotency_conflict, concurrency_conflict "the key already exists with different content"
    idempotency keyed_by settlement_ref
    concurrency unique_key settlement_ref
    evidence operation_trace
    lifecycle synchronous_request_response
}

operation record_disposition {
    intent "record the authorized disposition chosen after settlement and the resulting case lifecycle state"
    direction inbound
    actor DispositionAuthority
    access policy_governed by episode_level_never_closes_case at precondition fails with record_disposition_policy_denied, closed_requires_terminal_record at precondition fails with record_disposition_policy_denied, close_disposition_sets_closed at precondition fails with record_disposition_policy_denied, closed_only_by_case_level_close at precondition fails with record_disposition_policy_denied, suspend_sets_suspended at precondition fails with record_disposition_policy_denied, continue_revise_escalate_leave_open at precondition fails with record_disposition_policy_denied
    input RecordDispositionInput
    output RecordDispositionOutput
    state Disposition
    effect creates Disposition
    transaction single_aggregate
    failure record_disposition_invalid_input for input_validation "input failed record validation"
    failure record_disposition_policy_denied for policy "a bound precondition policy does not hold"
    failure record_disposition_conflict for idempotency_conflict, concurrency_conflict "the key already exists with different content"
    idempotency keyed_by disposition_id
    concurrency unique_key disposition_id
    evidence operation_trace
    lifecycle synchronous_request_response
}

operation assess_gate {
    intent "record the state of one evidence gate with its rationale"
    direction inbound
    actor FDE
    access policy_governed by not_applicable_needs_authorized_rationale at precondition fails with assess_gate_policy_denied, not_applicable_never_waives_hard_condition at precondition fails with assess_gate_policy_denied
    input AssessGateInput
    output AssessGateOutput
    state GateAssessment
    effect creates GateAssessment
    transaction single_aggregate
    failure assess_gate_invalid_input for input_validation "input failed record validation"
    failure assess_gate_policy_denied for policy "a bound precondition policy does not hold"
    failure assess_gate_conflict for idempotency_conflict, concurrency_conflict "the key already exists with different content"
    idempotency keyed_by assessment_id
    concurrency unique_key assessment_id
    evidence operation_trace
    lifecycle synchronous_request_response
}

