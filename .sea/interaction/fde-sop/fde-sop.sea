// ---------------------------------------------------------------------------
// Invariant policies (Obligation / Prohibition). Expressions state the
// PERMITTED condition; modality is metadata (DomainForge policy/core.rs).
// ---------------------------------------------------------------------------

policy episode_key_unique per Constraint Prohibition priority 9
    @rationale "SOP 2.2 and 7.2 (design constraint I-3, E 3): one frozen reference per (case, plan item, n). The expression is the permitted state: no earlier freeze exists for the key. The count is supplied by the caller; DomainForge does not check uniqueness itself."
    as: prior_freezes_for_key = 0

policy executor_never_rewrites_criteria per Constraint Prohibition priority 9
    @rationale "SOP 3.2: the evaluated executor never rewrites frozen criteria. The expression is the permitted state: the principal freezing a reference is not the executor."
    as: criteria_editor_ref != executor_ref

policy freeze_before_move per Constraint Obligation priority 9
    @rationale "SOP 7.2 (design constraint I-1, E 3): for an evaluated path the reference is fixed before execution. No move on an evaluated episode unless its freeze is recorded; an exploratory episode is labelled exploratory instead."
    as: episode_kind != "evaluated" or freeze_recorded = true

policy authorize_consequential_action per Constraint Obligation priority 9
    @rationale "SOP 7.3: SEA-Forge authorization is obtained at the action boundary for consequential actions."
    as: consequential = false or authorization_recorded = true

policy criteria_change_needs_new_version per Constraint Prohibition priority 9
    @rationale "SOP 7.3: within-reference corrections are allowed; a change to success criteria starts a new authorized evaluation version. A move may not carry changed criteria."
    as: criteria_changed = false

policy no_self_settlement per Constraint Prohibition priority 9
    @rationale "SOP 3.2 (design constraint I-2, E 3): the evaluated executor never attests its own independent acceptance. The expression is the permitted state: the settler is not the executor. Delegation-chain containment is a list and is not expressible (L2)."
    as: settler_ref != executor_ref

policy fresh_verifier_in_single_person_case per Constraint Obligation priority 9
    @rationale "SOP 3.2: in a one-person case independent settlement is performed by a fresh verifier, recorded as such. Only the recorded attestation is checkable; actual freshness of context is not."
    as: single_person_case = false or verifier_context_fresh = true

policy episode_level_never_closes_case per Constraint Prohibition priority 9
    @rationale "SOP 7.6: episode-level outcomes never close a case."
    as: level != "episode" or lifecycle_after != "closed"

policy closed_requires_terminal_record per Constraint Obligation priority 9
    @rationale "SOP 7.6: lifecycle closed requires a terminal case record."
    as: lifecycle_after != "closed" or terminal_case_record = true

policy close_disposition_sets_closed per Constraint Obligation priority 9
    @rationale "SOP 7.6: close-satisfied and close-failed set lifecycle closed (case-level dispositions only)."
    as: level != "case" or (disposition != "close-satisfied" and disposition != "close-failed") or lifecycle_after = "closed"

policy closed_only_by_case_level_close per Constraint Obligation priority 9
    @rationale "SOP 7.6: lifecycle closed requires a recorded case-level close disposition. This record is that disposition, so a closed lifecycle_after is permitted only for a case-level close."
    as: lifecycle_after != "closed" or (level = "case" and (disposition = "close-satisfied" or disposition = "close-failed"))

policy suspend_sets_suspended per Constraint Obligation priority 9
    @rationale "SOP 7.6: suspend sets lifecycle suspended (case-level only)."
    as: level != "case" or disposition != "suspend" or lifecycle_after = "suspended"

policy continue_revise_escalate_leave_open per Constraint Obligation priority 9
    @rationale "SOP 7.6: continue, revise and escalate leave the case open (case-level only)."
    as: level != "case" or (disposition != "continue" and disposition != "revise" and disposition != "escalate") or lifecycle_after = "open"

policy not_applicable_needs_authorized_rationale per Constraint Obligation priority 9
    @rationale "SOP 8.1: a gate is met, blocked, unassessed or not_applicable with authorized rationale."
    as: gate_state != "not_applicable" or rationale_authorized = true

policy not_applicable_never_waives_hard_condition per Constraint Prohibition priority 9
    @rationale "SOP 8.1: not applicable never waives a hard governance condition."
    as: gate_state != "not_applicable" or hard_governance_condition = false

policy activity_is_embed per Constraint Obligation priority 9
    @rationale "SOP 6: this operation records the Embed activity and no other."
    as: activity = "embed"

policy activity_is_observe per Constraint Obligation priority 9
    @rationale "SOP 6: this operation records the Observe activity and no other."
    as: activity = "observe"

policy activity_is_map per Constraint Obligation priority 9
    @rationale "SOP 6: this operation records the Map activity and no other."
    as: activity = "map"

policy activity_is_artifactize per Constraint Obligation priority 9
    @rationale "SOP 6: this operation records the Artifactize activity and no other."
    as: activity = "artifactize"

policy activity_is_prototype per Constraint Obligation priority 9
    @rationale "SOP 6: this operation records the Prototype activity and no other."
    as: activity = "prototype"

policy activity_is_validate per Constraint Obligation priority 9
    @rationale "SOP 6: this operation records the Validate activity and no other."
    as: activity = "validate"

policy validate_against_predeclared_expectation per Constraint Obligation priority 9
    @rationale "SOP 6 (Validate): compare against predeclared expectations."
    as: expectation_predeclared = true

policy activity_is_deploy per Constraint Obligation priority 9
    @rationale "SOP 6: this operation records the Deploy activity and no other."
    as: activity = "deploy"

policy activity_is_instrument per Constraint Obligation priority 9
    @rationale "SOP 6: this operation records the Instrument activity and no other."
    as: activity = "instrument"

policy activity_is_learn per Constraint Obligation priority 9
    @rationale "SOP 6: this operation records the Learn activity and no other."
    as: activity = "learn"

policy activity_is_compound per Constraint Obligation priority 9
    @rationale "SOP 6: this operation records the Compound activity and no other."
    as: activity = "compound"

// Graph-evaluated structure checks over declared instances.
policy four_layers as: count(i in entity_instances where i.entity = "Layer": i.layer_id) = 4
policy ten_components as: count(i in entity_instances where i.entity = "Component": i.component_id) = 10
policy ten_delivery_activities as: count(i in entity_instances where i.entity = "DeliveryActivityDef": i.activity_id) = 10
policy nine_evidence_gates as: count(i in entity_instances where i.entity = "EvidenceGate": i.gate_id) = 9
policy five_payment_currencies as: count(i in entity_instances where i.entity = "PaymentCurrency": i.currency_id) = 5
policy seven_reliability_dimensions as: count(i in entity_instances where i.entity = "ReliabilityDimension": i.dimension_id) = 7
policy seven_aim_dimensions as: count(i in entity_instances where i.entity = "AimDimension": i.dimension_id) = 7
policy six_record_owners as: count(i in entity_instances where i.entity = "RecordOwner": i.record_id) = 6
policy eight_acceptance_requirements as: count(i in entity_instances where i.entity = "AcceptanceRequirement": i.requirement_id) = 8

// Metrics. Structural only: the SOP's standing criterion needs runtime data a
// declaration cannot carry (map row A:178 is unknown).
metric "evidence_gate_count" as: count(i in entity_instances where i.entity = "EvidenceGate": i.gate_id) @unit "count" @target 9
metric "delivery_activity_count" as: count(i in entity_instances where i.entity = "DeliveryActivityDef": i.activity_id) @unit "count" @target 10
metric "payment_currency_count" as: count(i in entity_instances where i.entity = "PaymentCurrency": i.currency_id) @unit "count" @target 5

