@namespace "godspeed-fde-sop"
@version "0.1.0"
import { Settlement as EvidenceSettlement, EpistemicResult } from "./evidence.sea"
import { Settlement as OutcomeSettlement } from "./outcome.sea"

// GodSpeed FDE Operating Procedure GS-FDE-SOP-001 v0.4.1: declared model (WP-13).
//
// Source: docs/sop/GS-FDE-SOP-001-v0.4.1.md (draft, pending owner ratification
// OD-2). Every element below is traced to a numbered SOP clause in
// source-translation-map.md. Anything the SOP says that today's DomainForge
// grammar cannot express is NOT forced into a policy; it is `unknown` in the
// map with the limitation named (validation/limitations.md).
//
// Two contextual meanings of "settlement" are declared as two concepts in two
// namespaces that never unify:
//   godspeed-fde-sop.evidence::Settlement  evidence settlement of a frozen
//                                          expectation (S/F/U/C, SOP 7.5, 13)
//   godspeed-fde-sop.outcome::Settlement   the client-outcome / accepted business
//                                          result (SOP 3.1, 3.3, 10.2, 10.3)
// They are imported here under distinct local names. Operation-bound policies
// are scope-checked by `validate --application` (APP007) but evaluated only by
// the DomainForge evaluator (WP-12); see validation/limitations.md.

// ---------------------------------------------------------------------------
// Patterns and closed vocabularies
// ---------------------------------------------------------------------------

pattern "WorldRef" matches "^world:[a-z0-9._-]+@sha256:[0-9a-f]{64}$"

export enum CaseLifecycle {
    open = "open",
    suspended = "suspended",
    closed = "closed"
}

export enum ExecutionStatus {
    planned = "planned",
    running = "running",
    completed = "completed",
    failed = "failed",
    cancelled = "cancelled"
}

export enum EpisodeKind {
    evaluated = "evaluated",
    exploratory = "exploratory"
}

export enum DispositionLevel {
    case_level = "case",
    episode_level = "episode"
}

export enum DispositionKind {
    close_satisfied = "close-satisfied",
    close_failed = "close-failed",
    continue_work = "continue",
    revise = "revise",
    escalate = "escalate",
    suspend = "suspend"
}

export enum GateState {
    met = "met",
    blocked = "blocked",
    unassessed = "unassessed",
    not_applicable = "not_applicable"
}

export enum DifferenceDiagnosis {
    observation_or_instrumentation_problem = "observation_or_instrumentation_problem",
    mistaken_reference = "mistaken_reference",
    unsupported_inference = "unsupported_inference",
    implementation_failure = "implementation_failure",
    contextual_variation = "contextual_variation",
    inadequate_declared_structure = "inadequate_declared_structure"
}

export enum DeliveryActivity {
    embed = "embed",
    observe = "observe",
    map = "map",
    artifactize = "artifactize",
    prototype = "prototype",
    validate = "validate",
    deploy = "deploy",
    instrument = "instrument",
    learn = "learn",
    compound = "compound"
}

export enum EvidenceGateName {
    choose_problem = "choose_problem",
    discover_reality = "discover_reality",
    allocate_authority = "allocate_authority",
    prove_value = "prove_value",
    prove_reliability = "prove_reliability",
    integrate_govern = "integrate_govern",
    earn_trust = "earn_trust",
    measure = "measure",
    productize = "productize"
}

// ---------------------------------------------------------------------------
// Roles (SOP 3.1, 2.2) and role bindings
// ---------------------------------------------------------------------------

role "FDE"
role "Sponsor"
role "CriterionAuthor"
role "ExecutionActor"
role "IndependentVerifier"
role "DomainPolicyCustodian"
role "DEADESpecialist"
role "Approver"
role "DispositionAuthority"

role_binding "FDE" for "FieldCase"
role_binding "Sponsor" for "FieldCase"
role_binding "CriterionAuthor" for "Episode"
role_binding "ExecutionActor" for "Assignment"
role_binding "IndependentVerifier" for "Episode"
role_binding "DEADESpecialist" for "Assignment"
role_binding "DispositionAuthority" for "Disposition"

relation "VerifierIndependence"
    subject: "IndependentVerifier"
    predicate: "independently observes and settles work of"
    object: "ExecutionActor"

relation "ApprovalAuthority"
    subject: "Approver"
    predicate: "authorizes an action or promotion for"
    object: "ExecutionActor"

relation "DispositionChoice"
    subject: "DispositionAuthority"
    predicate: "chooses the section 7.5 disposition after settlement by"
    object: "IndependentVerifier"

// ---------------------------------------------------------------------------
// Case, episode and record entities (SOP 1.1, 2.1, 2.2, 4, 7, 8)
// ---------------------------------------------------------------------------

export entity "FieldCase" {
    key case_id: string (min_length 1)
    template_ref: string (min_length 1)
    lifecycle: CaseLifecycle
}

export entity "Episode" {
    key episode_ref: string (min_length 1)
    case_id: string (min_length 1)
    plan_item_id: string (min_length 1)
    n: int (min 1)
    kind: EpisodeKind
    world_ref: string (pattern WorldRef)
}

export entity "Assignment" {
    key assignment_id: string (min_length 1)
    case_id: string (min_length 1)
    episode_ref: string (min_length 1)
    world_ref: string (pattern WorldRef)
    criterion_ref: string (min_length 1)
    authority_ref: string (min_length 1)
    budget_ref: string (min_length 1)
}

export entity "ActivityRecord" {
    key activity_record_id: string (min_length 1)
    case_id: string (min_length 1)
    activity: DeliveryActivity
    output_ref: string (min_length 1)
}

export entity "GateAssessment" {
    key assessment_id: string (min_length 1)
    case_id: string (min_length 1)
    gate: EvidenceGateName
    gate_state: GateState
}

export entity "Disposition" {
    key disposition_id: string (min_length 1)
    case_id: string (min_length 1)
    level: DispositionLevel
    disposition: DispositionKind
    lifecycle_after: CaseLifecycle
}

// Vocabulary fixed by SOP 2.2 (names only; the definitions stay in the SOP).
export entity "Framing"
export entity "Projection"
export entity "CaseHorizon"
export entity "Residual"
export entity "Residue"
export entity "Checkpoint"
export entity "Run"
export entity "Session"

// Navigation vocabulary: the Golden Key steps are flow endpoints (SOP 2, 7).
export entity "NavListen"
export entity "NavAim"
export entity "NavMove"
export entity "NavClaim"

// ---------------------------------------------------------------------------
// Definitional tables (SOP 2, 3.4, 5.1, 6, 7.2, 7.7, 8.1, 11)
// ---------------------------------------------------------------------------

entity "Layer" {
    key layer_id: string
    name: string (min_length 1)
    job: string (min_length 1)
    question: string (min_length 1)
}

entity "Component" {
    key component_id: string
    name: string (min_length 1)
    responsibility: string (min_length 1)
}

entity "DeliveryActivityDef" {
    key activity_id: string
    name: string (min_length 1)
    action: string (min_length 1)
    durable_output: string (min_length 1)
}

entity "EvidenceGate" {
    key gate_id: string
    name: string (min_length 1)
    commitment_earned: string (min_length 1)
    minimum_evidence: string (min_length 1)
}

entity "PaymentCurrency" {
    key currency_id: string
    name: string (min_length 1)
}

entity "ReliabilityDimension" {
    key dimension_id: string
    name: string (min_length 1)
}

entity "AimDimension" {
    key dimension_id: string
    name: string (min_length 1)
}

entity "RecordOwner" {
    key record_id: string
    record: string (min_length 1)
    canonical_owner: string (min_length 1)
}

entity "AcceptanceRequirement" {
    key requirement_id: string
    statement: string (min_length 1)
}

instance layer_strategy of "Layer" {
    layer_id: "strategy",
    name: "Strategy",
    job: "choose customer, problem, desired progress, trade-offs, value, abandonment conditions",
    question: "which outcome is worth pursuing, for whom, why now"
}
instance layer_navigation of "Layer" {
    layer_id: "navigation",
    name: "Navigation",
    job: "recurs at every consequential decision",
    question: "what next, and what did reality establish"
}
instance layer_delivery of "Layer" {
    layer_id: "delivery",
    name: "Delivery",
    job: "repertoire of work; overlapping, repeatable, omittable",
    question: "what work creates or tests the next distinction"
}
instance layer_control of "Layer" {
    layer_id: "control",
    name: "Control",
    job: "independent predicates on the case, not a pipeline",
    question: "what evidence permits the next commitment"
}
instance component_domainforge of "Component" {
    component_id: "domainforge",
    name: "DomainForge / .sea",
    responsibility: "versioned domain meaning and Interaction Domain Models"
}
instance component_sea_forge_casework of "Component" {
    component_id: "sea_forge_casework",
    name: "SEA-Forge / Casework",
    responsibility: "governed case and action authority, policy, delegation, approval, obligations"
}
instance component_cognate of "Component" {
    component_id: "cognate",
    name: "Cognate",
    responsibility: "durable runtime, capabilities, events, projections, continuations"
}
instance component_horizon of "Component" {
    component_id: "horizon",
    name: "Horizon",
    responsibility: "human-facing world and case navigation, journal, affordance inspection, decisions, comparisons; presents, never decides"
}
instance component_cognate_workbench of "Component" {
    component_id: "cognate_workbench",
    name: "Cognate Workbench",
    responsibility: "agent work environment: assignments, sessions, deep-work execution linked to case and evidence"
}
instance component_realitytrace_sxr of "Component" {
    component_id: "realitytrace_sxr",
    name: "RealityTrace / SXR",
    responsibility: "pre-action expectations, observations, typed differences, provenance, residuals, settlement evidence"
}
instance component_gauntlet_swe_seed of "Component" {
    component_id: "gauntlet_swe_seed",
    name: "Gauntlet / SWE_SEED",
    responsibility: "bounded difficult execution and software verification against frozen references"
}
instance component_context_kernel of "Component" {
    component_id: "context_kernel",
    name: "Context Kernel",
    responsibility: "scoped retrieval with citations; reference material, not canonical truth"
}
instance component_ruvector of "Component" {
    component_id: "ruvector",
    name: "RuVector / derived indexes",
    responsibility: "Search and retrieval acceleration, not the record of authority or evidence"
}
instance component_godspeed_agent of "Component" {
    component_id: "godspeed_agent",
    name: "GodSpeed-Agent",
    responsibility: "developmental layer over settlement history; proposes, never authorizes"
}
instance activity_embed of "DeliveryActivityDef" {
    activity_id: "embed",
    name: "Embed",
    action: "establish sponsor decision, setting, users, incentives, constraints, permission; learn the work vocabulary",
    durable_output: "purpose, stakeholder/authority map, outcome hypothesis, approved observation access"
}
instance activity_observe of "DeliveryActivityDef" {
    activity_id: "observe",
    name: "Observe",
    action: "examine work-as-done: exceptions, workarounds, interruptions, handoffs, statement/operation gaps",
    durable_output: "source-grounded observations, chronology, contested claims, unknowns, baseline"
}
instance activity_map of "DeliveryActivityDef" {
    activity_id: "map",
    name: "Map",
    action: "reconstruct interactions, transitions, decision points, costs, failure paths, causal hypotheses; apply ODI/JTBD",
    durable_output: "interaction map, outcome measures, smallest consequential experiment candidates"
}
instance activity_artifactize of "DeliveryActivityDef" {
    activity_id: "artifactize",
    name: "Artifactize",
    action: "capture minimum reviewable meaning in a validated IDM/.sea with source mappings and unknowns",
    durable_output: "versioned semantic world, interpretation provenance, model identity"
}
instance activity_prototype of "DeliveryActivityDef" {
    activity_id: "prototype",
    name: "Prototype",
    action: "exercise the smallest admitted path that distinguishes hypotheses or produces value",
    durable_output: "frozen hypothesis, bounded slice, real inputs/outputs, trace identifiers"
}
instance activity_validate of "DeliveryActivityDef" {
    activity_id: "validate",
    name: "Validate",
    action: "compare against predeclared expectations; challenge implementation, representation, attribution, recovery; use independent acceptance tests and meaningful variation",
    durable_output: "RealityTrace evidence, verified/failed/unresolved results, reviewer disposition"
}
instance activity_deploy of "DeliveryActivityDef" {
    activity_id: "deploy",
    name: "Deploy",
    action: "bind to real systems, actors, permissions, capacity, monitoring, reversibility",
    durable_output: "authorized activation record, operational owner, recovery procedure"
}
instance activity_instrument of "DeliveryActivityDef" {
    activity_id: "instrument",
    name: "Instrument",
    action: "semantic observation throughout; correlate action to meaning, authority, cost, evidence, consequence",
    durable_output: "durable semantic exhaust, observed model, burden measures, coverage gaps"
}
instance activity_learn of "DeliveryActivityDef" {
    activity_id: "learn",
    name: "Learn",
    action: "diagnose residuals: observation, reference, inference, implementation, or structure; test corrections",
    durable_output: "diagnostic account, retained residuals, versioned proposals, subsequent-episode tests"
}
instance activity_compound of "DeliveryActivityDef" {
    activity_id: "compound",
    name: "Compound",
    action: "preserve what later work can reuse and test its portability",
    durable_output: "candidate reusable assets, variation/transfer evidence, productization decision"
}
instance gate_choose_problem of "EvidenceGate" {
    gate_id: "choose_problem",
    name: "Choose Problem",
    commitment_earned: "invest in discovery",
    minimum_evidence: "sponsor-owned need, JTBD outcome, plausible value, scope"
}
instance gate_discover_reality of "EvidenceGate" {
    gate_id: "discover_reality",
    name: "Discover Reality",
    commitment_earned: "select an intervention or inquiry",
    minimum_evidence: "work-as-done observations, baseline, exceptions, competing interpretations, missing knowledge"
}
instance gate_allocate_authority of "EvidenceGate" {
    gate_id: "allocate_authority",
    name: "Allocate Authority",
    commitment_earned: "delegate or authorize consequential work",
    minimum_evidence: "roles, scope, policy, approval, recovery ownership, permission boundaries"
}
instance gate_prove_value of "EvidenceGate" {
    gate_id: "prove_value",
    name: "Prove Value",
    commitment_earned: "claim pilot benefit",
    minimum_evidence: "frozen hypothesis and evaluator, representative observation, baseline comparison, measured actual payment"
}
instance gate_prove_reliability of "EvidenceGate" {
    gate_id: "prove_reliability",
    name: "Prove Reliability",
    commitment_earned: "expand reliance",
    minimum_evidence: "independent repeated settlement under variation, edge cases, recovery, known limits"
}
instance gate_integrate_govern of "EvidenceGate" {
    gate_id: "integrate_govern",
    name: "Integrate/Govern",
    commitment_earned: "operate in the intended environment",
    minimum_evidence: "approved real connections, authority enforcement, observability, rollback, security, operational owner"
}
instance gate_earn_trust of "EvidenceGate" {
    gate_id: "earn_trust",
    name: "Earn Trust",
    commitment_earned: "expect informed human use",
    minimum_evidence: "actual operator/client understanding, informed adoption, escalation and recovery behaviour"
}
instance gate_measure of "EvidenceGate" {
    gate_id: "measure",
    name: "Measure",
    commitment_earned: "claim attributable improvement",
    minimum_evidence: "benefit and all payment currencies, debt, externalities, confounders, limits"
}
instance gate_productize of "EvidenceGate" {
    gate_id: "productize",
    name: "Productize",
    commitment_earned: "offer a reusable capability",
    minimum_evidence: "versioned pattern, transfer hypothesis, repeatability/variation/recovery evidence, business case"
}
instance currency_time of "PaymentCurrency" {
    currency_id: "time",
    name: "time"
}
instance currency_attention of "PaymentCurrency" {
    currency_id: "attention",
    name: "attention"
}
instance currency_money of "PaymentCurrency" {
    currency_id: "money",
    name: "money"
}
instance currency_risk of "PaymentCurrency" {
    currency_id: "risk",
    name: "risk"
}
instance currency_recovery of "PaymentCurrency" {
    currency_id: "recovery",
    name: "recovery"
}
instance reliability_T of "ReliabilityDimension" {
    dimension_id: "T",
    name: "timeliness"
}
instance reliability_A of "ReliabilityDimension" {
    dimension_id: "A",
    name: "attribution"
}
instance reliability_I of "ReliabilityDimension" {
    dimension_id: "I",
    name: "incentive alignment"
}
instance reliability_K of "ReliabilityDimension" {
    dimension_id: "K",
    name: "corroboration"
}
instance reliability_D of "ReliabilityDimension" {
    dimension_id: "D",
    name: "debt visibility"
}
instance reliability_X of "ReliabilityDimension" {
    dimension_id: "X",
    name: "externality detection"
}
instance reliability_N of "ReliabilityDimension" {
    dimension_id: "N",
    name: "non-adversariality"
}
instance aim_visibility of "AimDimension" {
    dimension_id: "visibility",
    name: "visibility"
}
instance aim_reach of "AimDimension" {
    dimension_id: "reach",
    name: "reach"
}
instance aim_payment of "AimDimension" {
    dimension_id: "payment",
    name: "payment"
}
instance aim_executable_capability of "AimDimension" {
    dimension_id: "executable_capability",
    name: "executable capability"
}
instance aim_authority of "AimDimension" {
    dimension_id: "authority",
    name: "authority"
}
instance aim_recovery of "AimDimension" {
    dimension_id: "recovery",
    name: "recovery"
}
instance aim_settlement_access of "AimDimension" {
    dimension_id: "settlement_access",
    name: "settlement access"
}
instance owner_case_and_assignments of "RecordOwner" {
    record_id: "case_and_assignments",
    record: "Case and assignments",
    canonical_owner: "Casework/Cognate case and event interfaces; Horizon is the operator view"
}
instance owner_declared_interaction_model of "RecordOwner" {
    record_id: "declared_interaction_model",
    record: "Declared interaction model",
    canonical_owner: "validated .sea in the owning domain's .sea/interaction/, with model hash and source translation"
}
instance owner_frozen_episode_reference of "RecordOwner" {
    record_id: "frozen_episode_reference",
    record: "Frozen episode reference",
    canonical_owner: "evaluation and execution contract fixed before the act; linked from case events and RealityTrace"
}
instance owner_observed_traces of "RecordOwner" {
    record_id: "observed_traces",
    record: "Observed traces and comparisons",
    canonical_owner: "RealityTrace records and derivable observed representation; the case carries references, not a copy"
}
instance owner_decision_review_residue of "RecordOwner" {
    record_id: "decision_review_residue",
    record: "Decision, review, developmental residue",
    canonical_owner: "attributable authorization/acceptance, case decisions, candidate revision or reusable artifact"
}
instance owner_proof_report of "RecordOwner" {
    record_id: "proof_report",
    record: "Proof report",
    canonical_owner: "reproduction commands, source hashes, positive and adversarial results, uncertainty, verifier identity"
}
instance acceptance_1 of "AcceptanceRequirement" {
    requirement_id: "R1",
    statement: "reconstruct or validate the initial IDM from this SOP and its source evidence"
}
instance acceptance_2 of "AcceptanceRequirement" {
    requirement_id: "R2",
    statement: "resume the case from authoritative records and select a real or blocked affordance without reconstructing hidden context"
}
instance acceptance_3 of "AcceptanceRequirement" {
    requirement_id: "R3",
    statement: "run a bounded governed inquiry against an expectation frozen beforehand and inspect execution and evidence"
}
instance acceptance_4 of "AcceptanceRequirement" {
    requirement_id: "R4",
    statement: "derive an observed interaction representation, compare it with the declared version, classify at least one difference or evidence gap"
}
instance acceptance_5 of "AcceptanceRequirement" {
    requirement_id: "R5",
    statement: "independently settle an episode, authorize its disposition, preserve the original reference and all negative or unresolved evidence"
}
instance acceptance_6 of "AcceptanceRequirement" {
    requirement_id: "R6",
    statement: "where justified, validate and authorize a candidate model and test a subsequent episode under it; where not, retain the divergence and the rationale"
}
instance acceptance_7 of "AcceptanceRequirement" {
    requirement_id: "R7",
    statement: "inspect the same case, differences, authority and evidence through Horizon and programmatic records without inconsistent verdicts"
}
instance acceptance_8 of "AcceptanceRequirement" {
    requirement_id: "R8",
    statement: "transfer the templates and instrumentation to a second bounded situation without rewriting the core evidence mechanism"
}

// ---------------------------------------------------------------------------
// Navigation flow (SOP 2: Listen, Aim, Move, Claim recurs at every decision)
// ---------------------------------------------------------------------------

resource "CaseReading"
resource "FrozenExpectation"
resource "ExecutionTrace"
resource "SettlementEvidence"

flow "CaseReading"
    @phase "listen"
    from "NavListen" to "NavAim"
    quantity 1

flow "FrozenExpectation"
    @phase "aim"
    from "NavAim" to "NavMove"
    quantity 1

flow "ExecutionTrace"
    @phase "move"
    from "NavMove" to "NavClaim"
    quantity 1

flow "SettlementEvidence"
    @phase "claim"
    from "NavClaim" to "NavListen"
    quantity 1

record CaseOpenOrResumeInput {
    case_id: string (min_length 1)
}
record CaseOpenOrResumeOutput {
    case_id: string (min_length 1)
    template_ref: string (min_length 1)
    lifecycle: CaseLifecycle
}
record NavListenInput {
    case_id: string (min_length 1)
}
record NavListenOutput {
    case_id: string (min_length 1)
    lifecycle: CaseLifecycle
}
record NavAimInput {
    episode_ref: string (min_length 1)
    case_id: string (min_length 1)
    plan_item_id: string (min_length 1)
    n: int (min 1)
    kind: EpisodeKind
    world_ref: string (pattern WorldRef)
    prior_freezes_for_key: int (min 0)
    criteria_editor_ref: string (min_length 1)
    executor_ref: string (min_length 1)
}
record NavAimOutput {
    episode_ref: string (min_length 1)
    case_id: string (min_length 1)
    plan_item_id: string (min_length 1)
    n: int (min 1)
    kind: EpisodeKind
    world_ref: string (pattern WorldRef)
}
record NavMoveInput {
    assignment_id: string (min_length 1)
    case_id: string (min_length 1)
    episode_ref: string (min_length 1)
    world_ref: string (pattern WorldRef)
    criterion_ref: string (min_length 1)
    authority_ref: string (min_length 1)
    budget_ref: string (min_length 1)
    episode_kind: EpisodeKind
    freeze_recorded: bool
    consequential: bool
    authorization_recorded: bool
    criteria_changed: bool
}
record NavMoveOutput {
    assignment_id: string (min_length 1)
    case_id: string (min_length 1)
    episode_ref: string (min_length 1)
    world_ref: string (pattern WorldRef)
    criterion_ref: string (min_length 1)
    authority_ref: string (min_length 1)
    budget_ref: string (min_length 1)
}
record NavClaimInput {
    settlement_ref: string (min_length 1)
    episode_ref: string (min_length 1)
    result: string (pattern EpistemicResult)
    reliability: string (min_length 1)
    source_independence: string (min_length 1)
    observation_ref: string (min_length 1)
    executor_ref: string (min_length 1)
    settler_ref: string (min_length 1)
    single_person_case: bool
    verifier_context_fresh: bool
}
record NavClaimOutput {
    settlement_ref: string (min_length 1)
    episode_ref: string (min_length 1)
    result: string (pattern EpistemicResult)
    reliability: string (min_length 1)
    source_independence: string (min_length 1)
}
record RecordDispositionInput {
    disposition_id: string (min_length 1)
    case_id: string (min_length 1)
    level: DispositionLevel
    disposition: DispositionKind
    lifecycle_after: CaseLifecycle
    terminal_case_record: bool
}
record RecordDispositionOutput {
    disposition_id: string (min_length 1)
    case_id: string (min_length 1)
    level: DispositionLevel
    disposition: DispositionKind
    lifecycle_after: CaseLifecycle
}
record AssessGateInput {
    assessment_id: string (min_length 1)
    case_id: string (min_length 1)
    gate: EvidenceGateName
    gate_state: GateState
    rationale_authorized: bool
    hard_governance_condition: bool
}
record AssessGateOutput {
    assessment_id: string (min_length 1)
    case_id: string (min_length 1)
    gate: EvidenceGateName
    gate_state: GateState
}
record AcceptClientOutcomeInput {
    outcome_ref: string (min_length 1)
    case_id: string (min_length 1)
    accepted_by_ref: string (min_length 1)
    account_ref: string (min_length 1)
}
record AcceptClientOutcomeOutput {
    outcome_ref: string (min_length 1)
    case_id: string (min_length 1)
    accepted_by_ref: string (min_length 1)
    account_ref: string (min_length 1)
}
record ActEmbedInput {
    activity_record_id: string (min_length 1)
    case_id: string (min_length 1)
    activity: DeliveryActivity
    output_ref: string (min_length 1)
}
record ActEmbedOutput {
    activity_record_id: string (min_length 1)
    case_id: string (min_length 1)
    activity: DeliveryActivity
    output_ref: string (min_length 1)
}
record ActObserveInput {
