@namespace "sea_forge.interaction"
@version "0.2.0"

// SEA Forge canonical interaction domain model.
//
// Authority: this file is the single semantic authority for SEA Forge's
// interaction domain. It is authored against DomainForge 0.16.0, which
// supports typed entity bodies, entity keys, closed enums, scalar and
// pattern constraints, typed instance references with dangling-reference
// rejection, and policies that quantify over concrete entity instances.
//
// The 0.15.0-era workarounds are gone: journey identity, classification,
// maturity, and interface bindings are typed and validated rather than
// semicolon-separated strings, and journey meaning is stated once on the
// journey instance instead of being duplicated into flow annotations.
//
// Routes, SFWP methods, CLI commands, and agent surfaces are projections of
// this model. They never define canonical journey identity, and their
// existence never proves that a journey is complete.

// ---------------------------------------------------------------------------
// Identity patterns
// ---------------------------------------------------------------------------

pattern "JourneyId" matches "^CJ(0[1-9]|1[0-2])$"
pattern "InterfaceBindingId" matches "^IB[0-9]{3}$"
pattern "InteractionStepId" matches "^IS[1-8]$"

// ---------------------------------------------------------------------------
// Closed vocabularies
//
// Classification and implementation maturity are independent axes. A
// classification records how an observed story relates to a canonical journey;
// it never promotes that story into evidence of shipped behavior.
// ---------------------------------------------------------------------------

export enum CanonicalizationClass {
    canonical = "canonical",
    specialization = "specialization",
    variant = "variant",
    composition = "composition",
    duplicate = "duplicate",
    obsolete = "obsolete",
    ambiguous = "ambiguous",
    unsupported = "unsupported"
}

export enum ImplementationMaturity {
    declared = "declared",
    specified = "specified",
    implemented = "implemented",
    exercised = "exercised",
    evidenced = "evidenced"
}

export enum InterfaceKind {
    web_ui = "web_ui",
    api = "api",
    cli = "cli",
    agent = "agent"
}

export enum InteractionPhase {
    context_selection = "context_selection",
    preflight = "preflight",
    authority_resolution = "authority_resolution",
    capability_invocation = "capability_invocation",
    state_and_artifact_effect = "state_and_artifact_effect",
    evidence_inspection = "evidence_inspection",
    settlement_or_decision = "settlement_or_decision",
    next_affordance_selection = "next_affordance_selection"
}

// ---------------------------------------------------------------------------
// Actors
// ---------------------------------------------------------------------------

export role "Operator"
export role "CaseOwner"
export role "Approver"
export role "DomainAuthor"
export role "AgentSponsor"
export role "Auditor"
export role "CellAdministrator"
export role "ExternalActor"
export role "AutomatedActor"

// ---------------------------------------------------------------------------
// Universal interaction ontology
//
// These entities stay schemaless on purpose. They are the endpoints of the
// interaction skeleton flows and the vocabulary the catalog explains; they
// carry no per-instance state in this model.
// ---------------------------------------------------------------------------

export entity "UserIntent"
export entity "UserAction"
export entity "InteractionState"
export entity "SystemCapability"
export entity "Artifact"
export entity "Evidence"
export entity "Decision"
export entity "RecoveryPath"

export resource "InteractionProgress"
export resource "GovernedEvidence"
export resource "GovernedArtifact"
export resource "DecisionContext"
export resource "LawfulAffordance"

relation "Sponsorship"
    subject: "AgentSponsor"
    predicate: "is accountable sponsor for"
    object: "AutomatedActor"

relation "ApprovalJudgment"
    subject: "Approver"
    predicate: "renders governed judgment for"
    object: "CaseOwner"

relation "AuditReview"
    subject: "Auditor"
    predicate: "reviews governed activity of"
    object: "Operator"

// ---------------------------------------------------------------------------
// Typed catalog entities
// ---------------------------------------------------------------------------

// Exactly one product purpose may be declared. It is the root of the model:
// every canonical journey below is one stable way an actor pursues it.
export entity "ProductPurpose" {
    key purpose_id: string (min_length 6)
    statement: string (min_length 100)
    governing_constraint: string (min_length 100)
    out_of_scope: string (min_length 100)
}

export entity "JourneyStep" {
    key step_id: string (pattern InteractionStepId)
    phase: InteractionPhase
    ordinal: int (min 1, max 8)
    purpose: string (min_length 40)
}

export entity "CanonicalJourney" {
    key journey_id: string (pattern JourneyId)
    slug: string (min_length 8, max_length 64)
    title: string (min_length 12, max_length 80)
    intention: string (min_length 60)
    user_job: string (min_length 60)
    initiating_condition: string (min_length 60)
    preconditions: string (min_length 60)
    entry_points: string (min_length 60)
    reusable_steps: string (min_length 120)
    capabilities: string (min_length 60)
    state_transition: string (min_length 120)
    artifacts: string (min_length 60)
    evidence: string (min_length 100)
    completion_condition: string (min_length 100)
    next_decisions: string (min_length 60)
    recovery_paths: string (min_length 100)
    known_variants: string (min_length 100)
    maturity_note: string (min_length 100)
    observed_story_count: int (min 1, max 128)
    specified_story_count: int (min 0, max 128)
    implemented_story_count: int (min 0, max 128)
    exercised_story_count: int (min 0, max 128)
    evidenced_story_count: int (min 0, max 128)
    interface_binding_count: int (min 1, max 128)
}

export entity "CanonicalizationClassification" {
    key classification_id: string (min_length 6)
    class_value: CanonicalizationClass
    observed_rows: int (min 0, max 128)
    semantics: string (min_length 40)
    evidence: string (min_length 10)
}

export entity "VariationDimension" {
    key dimension_id: string (min_length 6)
    dimension_family: string (min_length 6)
    recurring_values: string (min_length 40)
    value_derived_concepts: string optional (min_length 5)
    literal_matrix_keys: string (min_length 4)
    evidence: string (min_length 10)
}

export entity "InterfaceSurface" {
    key surface_id: string (min_length 6)
    interface_kind: InterfaceKind
    entry_or_method: string (min_length 3)
    binding_role: string (min_length 60)
    implementation_maturity: ImplementationMaturity
    source_ref: string (min_length 40)
    limitations: string (min_length 60)
}

// One row per (surface, canonical journey) pair. A surface that projects
// several journeys owns several bindings; several surfaces may bind to one
// journey. Both references are typed, so a binding to a surface or a journey
// that does not exist is rejected by DomainForge rather than by convention.
export entity "InterfaceBinding" {
    key binding_id: string (pattern InterfaceBindingId)
    surface: ref<InterfaceSurface>
    journey: ref<CanonicalJourney>
}

// ---------------------------------------------------------------------------
// Product purpose
// ---------------------------------------------------------------------------

instance sea_forge_purpose of "ProductPurpose" {
    purpose_id: "sea_forge",
    statement: "SEA Forge lets a human or sponsored automated actor turn intent into governed work inside a cell whose identity, semantics, authority, evidence, and settlement are explicit at every step, so that what was intended, authorized, attempted, observed, accepted, and reused can each be proven from immutable records rather than inferred from an interface.",
    governing_constraint: "Authority is resolved before every effect, including read-only disclosure; execution termination is never settlement; history is appended and never rewritten; and a projection, index, summary, or generated artifact never becomes authoritative truth about what occurred.",
    out_of_scope: "This model describes interaction meaning only. SEA Forge's governed records - cases, plans, runs, approvals, ledgers, capabilities, artifacts, and bundles - are defined by their own repository specifications, and their definitions are referenced here rather than restated, so that no competing definition of a governed record can originate in the interaction model."
}

// ---------------------------------------------------------------------------
// Reusable interaction skeleton
//
// Every canonical journey traverses these eight phases in order. Intention is
// not a step: it is the journey's own declared purpose. Denial, escalation,
// expiry, interruption, timeout, cancellation, stale state, quarantine, and
// unsupported state use the same skeleton and close with recovery or terminal
// semantics instead of becoming generic errors.
// ---------------------------------------------------------------------------

instance step_context_selection of "JourneyStep" {
    step_id: "IS1",
    phase: "context_selection",
    ordinal: 1,
    purpose: "Select or supply the governed cell, actor, case, semantic, provider, and work context, together with the immutable snapshots that context depends on."
}

instance step_preflight of "JourneyStep" {
    step_id: "IS2",
    phase: "preflight",
    ordinal: 2,
    purpose: "Validate readiness, availability, dependency, compatibility, and limit constraints before a protected action is attempted."
}

instance step_authority_resolution of "JourneyStep" {
    step_id: "IS3",
    phase: "authority_resolution",
    ordinal: 3,
    purpose: "Resolve disclosure, policy, eligibility, separation of duty, and the exact grant before any effect, including read-only disclosure."
}

instance step_capability_invocation of "JourneyStep" {
    step_id: "IS4",
    phase: "capability_invocation",
    ordinal: 4,
    purpose: "Invoke exactly one typed and bounded behavior inside the granted boundary; intent is never interpolated into an untyped command or path."
}

instance step_state_and_artifact_effect of "JourneyStep" {
    step_id: "IS5",
    phase: "state_and_artifact_effect",
    ordinal: 5,
    purpose: "Append a governed state transition or create an attributable artifact. Read-only interaction produces a source-linked projection rather than new truth."
}

instance step_evidence_inspection of "JourneyStep" {
    step_id: "IS6",
    phase: "evidence_inspection",
    ordinal: 6,
    purpose: "Expose records, hashes, provenance, freshness, assurance, missing conditions, and disclosure limits. Process exit and narration are evidence inputs, not acceptance."
}

instance step_settlement_or_decision of "JourneyStep" {
    step_id: "IS7",
    phase: "settlement_or_decision",
    ordinal: 7,
    purpose: "Evaluate the declared completion rule or reach an explicit governed decision. Settlement remains separate from execution termination."
}

instance step_next_affordance_selection of "JourneyStep" {
    step_id: "IS8",
    phase: "next_affordance_selection",
    ordinal: 8,
    purpose: "Offer only actions that are simultaneously visible, reachable, permitted, and settleable in the new context, or end at an explicit terminal condition."
}

// ---------------------------------------------------------------------------
// Canonical journeys
//
// Twelve journeys explain all 128 observed stories in the governed Workbench
// UX epic. The per-journey story counts below are the SEA-side reconciliation
// of canonicalization-matrix.csv; the policies at the end of this file prove
// they still total 128 and still match the reconciled maturity distribution.
// ---------------------------------------------------------------------------

instance establish_trusted_cell_context of "CanonicalJourney" {
    journey_id: "CJ01",
    slug: "establish_trusted_cell_context",
    title: "Establish Trusted Cell Context",
    intention: "Enter a cell whose identity, configuration, integrity, semantic self-model, and operation-specific readiness are explicit.",
    user_job: "Establish a trustworthy starting context for a human or automated actor without overwriting history or treating stale state as current.",
    initiating_condition: "A user opens or creates a cell, returns to existing or legacy history, starts the service, enters protected work, or changes the release or execution substrate.",
    preconditions: "A selected cell root; readable existing records when present; configured identity, policy, ledger, model, extension, environment, endpoint, and server inputs appropriate to the intended operation.",
    entry_points: "Cell selection or initialization, migration, startup preflight, identity resolution, readiness inspection, policy inspection, self-model maintenance, and compatibility inspection.",
    reusable_steps: "Identify the cell and actor; preserve or migrate attributable history; validate required foundations; realize and hash-pin the self-model snapshot; inspect policy and version compatibility; classify readiness; expose affected capabilities and corrective actions.",
    capabilities: "Cell initialization and bundle-aware migration, startup validation, `identity.get`, `readiness.get`, policy inspection, self-model validation or rebuild, lifecycle inspection, and version-skew detection.",
    state_transition: "Unknown, legacy, or changed context becomes validated current context, explicitly stale but verifiable context, degraded context, or blocked context; invalid identity and configuration fail closed; lifecycle changes preserve in-flight snapshots.",
    artifacts: "Cell identity, existing case and ledger history, migration records, policy and configuration digests, release-and-cell self-model snapshots, readiness items, assurance labels, and compatibility findings.",
    evidence: "Governed UX epic §§1, 2.1–2.4, and 16.1–16.5; `spec-minimum.md` §§7.3.3, 8, 8.5, 10.2, and 14; `spec-full.md` §§7.0b–7.0c and 7.4; `sea-forge-cell`, `sea-forge-self-model`, lifecycle, identity, readiness, and version-skew conformance tests; `USER_JOURNEY_EVIDENCE.md` Journeys 1, 4, 6, 6b, and 8b.",
    completion_condition: "The actor is attributable, the governing snapshots and integrity state are explicit, and the cell states whether the intended operation is ready, degraded, stale, or blocked with evidence.",
    next_decisions: "Discover current lawful affordances, form a governed case, repair or revalidate a failed foundation, hold an incompatible operation, or stop.",
    recovery_paths: "Preserve prior verifiable snapshots; refuse protected work on identity conflict; rebuild or reprobe changed foundations; migrate compatible history without re-keying it; follow the readiness item to a bounded repair path.",
    known_variants: "New versus returning cells; legacy migration; human versus sponsored automated actors; healthy, stale, degraded, unavailable, quarantined, integrity-pending, or blocked readiness; release, extension, endpoint, environment, and toolchain changes.",
    maturity_note: "15 mapped stories: 1 specified, 2 implemented, 5 exercised, and 7 evidenced. Sponsorship remains specified; the complete extension and endpoint lifecycle is only partly surfaced; readiness, identity, migration, snapshots, and compatibility have stronger test or execution evidence.",
    observed_story_count: 15,
    specified_story_count: 1,
    implemented_story_count: 2,
    exercised_story_count: 5,
    evidenced_story_count: 7,
    interface_binding_count: 5
}

