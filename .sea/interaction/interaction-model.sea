    implementation_maturity: "exercised",
    source_ref: ".agents/specs/spec-agent-orchestration.md §§7.6, 10.3, and 16.2; crates/sea-forge-cli/src/commands/manager.rs; crates/sea-forge-cli/tests/conformance_m15.rs",
    limitations: "The manager is invoked, never a hidden daemon; the grant bounds iterations; exhaustion parks and escalates. It cannot invent arbitrary work, auto-route endpoints, approve, execute privately, settle, or promote its own proposal."
}

instance agent_endpoint_surface of "InterfaceSurface" {
    surface_id: "agent_endpoint_surface",
    interface_kind: "agent",
    entry_or_method: "asset.list endpoint rows; sea-forge agent list|probe; HTTP-compatible and ACP endpoint descriptors",
    binding_role: "Discover configured agent providers and demonstrate endpoint compatibility through an exact authority-gated probe.",
    implementation_maturity: "exercised",
    source_ref: ".agents/specs/spec-agent-orchestration.md §§7.1-7.2 and 10.1; crates/sea-forge-server/src/sfwp/assets.rs; crates/sea-forge-server/tests/conformance_m12.rs",
    limitations: "Configured, syntactically valid, available, and demonstrated remain separate. Endpoint identifiers do not grant network, process, model, credential, or secret access, and the complete target endpoint lifecycle API is absent."
}

instance agent_delegation_execution_surface of "InterfaceSurface" {
    surface_id: "agent_delegation_execution_surface",
    interface_kind: "agent",
    entry_or_method: "delegation.preview; legacy delegate; agent_task case episodes; HTTP, ACP, and SWE_SEED executors",
    binding_role: "Bind a job contract, authorize exact external action and secrets, execute bounded agent work, capture transcript and harness evidence, and submit the episode to independent settlement.",
    implementation_maturity: "exercised",
    source_ref: ".agents/specs/spec-agent-orchestration.md §§7.3-7.5, 10.1-10.2, and 17.2; crates/sea-forge-server/src/delegation.rs; crates/sea-forge-server/src/sfwp/delegation_preview.rs; crates/sea-forge-server/tests/conformance_m13.rs",
    limitations: "Preview eligibility is not authority and agent narration is not proof. Real compatible-host ACP and SWE_SEED release evidence remains skipped; portable fixtures and harvest paths are exercised. Every termination still requires retained evidence and separate settlement."
}

instance agent_delegation_control_surface of "InterfaceSurface" {
    surface_id: "agent_delegation_control_surface",
    interface_kind: "agent",
    entry_or_method: "delegation.list; legacy cancel_delegation; ACP permission-to-approval bridge; run.get",
    binding_role: "Observe delegation standing separately from settlement, cancel one live episode without its siblings, and route ACP permission requests through ordinary governed decisions.",
    implementation_maturity: "exercised",
    source_ref: ".agents/specs/spec-agent-orchestration.md §§7.5, 10.4, and 17.5; crates/sea-forge-server/src/sfwp/delegations.rs; crates/sea-forge-server/src/delegation.rs; crates/sea-forge-server/tests/conformance_m16.rs",
    limitations: "CancellationRequested is not a terminal outcome; Unresolved is not failed; and Settled does not imply accepted. The kernel publishes no per-turn live count. ACP denial leaves a session alive unless cancellation or termination separately ends it."
}

