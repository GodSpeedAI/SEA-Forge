// ---------------------------------------------------------------------------
// Interaction skeleton flows
//
// A SEA flow is a resource moving between entities. These four flows are the
// universal interaction transformation; they are not journey identity.
// ---------------------------------------------------------------------------

flow "InteractionProgress"
    @phase "intent_normalization"
    from "UserIntent" to "CanonicalJourney"
    quantity 1

flow "GovernedEvidence"
    @phase "evidence_inspection"
    from "SystemCapability" to "Evidence"
    quantity 1

flow "DecisionContext"
    @phase "settlement_or_decision"
    from "Evidence" to "Decision"
    quantity 1

flow "LawfulAffordance"
    @phase "next_affordance_selection"
    from "Decision" to "UserAction"
    quantity 1

// ---------------------------------------------------------------------------
// Canonical journey transition states
//
// Each journey moves one InteractionProgress unit from its entry state to its
// completion state. The journey instance above states what that transition
// means; the flow states only that the transition exists, so the meaning is
// declared once instead of being duplicated into flow annotations.
// ---------------------------------------------------------------------------

entity "CJ01EntryState"
entity "CJ01CompletionState"
entity "CJ02EntryState"
entity "CJ02CompletionState"
entity "CJ03EntryState"
entity "CJ03CompletionState"
entity "CJ04EntryState"
entity "CJ04CompletionState"
entity "CJ05EntryState"
entity "CJ05CompletionState"
entity "CJ06EntryState"
entity "CJ06CompletionState"
entity "CJ07EntryState"
entity "CJ07CompletionState"
entity "CJ08EntryState"
entity "CJ08CompletionState"
entity "CJ09EntryState"
entity "CJ09CompletionState"
entity "CJ10EntryState"
entity "CJ10CompletionState"
entity "CJ11EntryState"
entity "CJ11CompletionState"
entity "CJ12EntryState"
entity "CJ12CompletionState"

flow "InteractionProgress"
    @journey_id "CJ01"
    from "CJ01EntryState" to "CJ01CompletionState"
    quantity 1

flow "InteractionProgress"
    @journey_id "CJ02"
    from "CJ02EntryState" to "CJ02CompletionState"
    quantity 1

flow "InteractionProgress"
    @journey_id "CJ03"
    from "CJ03EntryState" to "CJ03CompletionState"
    quantity 1

flow "InteractionProgress"
    @journey_id "CJ04"
    from "CJ04EntryState" to "CJ04CompletionState"
    quantity 1

flow "InteractionProgress"
    @journey_id "CJ05"
    from "CJ05EntryState" to "CJ05CompletionState"
    quantity 1

flow "InteractionProgress"
    @journey_id "CJ06"
    from "CJ06EntryState" to "CJ06CompletionState"
    quantity 1

flow "InteractionProgress"
    @journey_id "CJ07"
    from "CJ07EntryState" to "CJ07CompletionState"
    quantity 1

flow "InteractionProgress"
    @journey_id "CJ08"
    from "CJ08EntryState" to "CJ08CompletionState"
    quantity 1

flow "InteractionProgress"
    @journey_id "CJ09"
    from "CJ09EntryState" to "CJ09CompletionState"
    quantity 1

flow "InteractionProgress"
    @journey_id "CJ10"
    from "CJ10EntryState" to "CJ10CompletionState"
    quantity 1

flow "InteractionProgress"
    @journey_id "CJ11"
    from "CJ11EntryState" to "CJ11CompletionState"
    quantity 1

flow "InteractionProgress"
    @journey_id "CJ12"
    from "CJ12EntryState" to "CJ12CompletionState"
    quantity 1

// ---------------------------------------------------------------------------
// Application boundary
//
// One read boundary is declared over the canonical journey catalog. It is the
// stable operation contract that every catalog-projecting surface realizes:
// Workbench /capabilities and /thoth, the SFWP system.describe and thoth.ask
// methods, and `sea-forge ask` are adapters over this one boundary, not
// separate meanings. No write operation is declared: the catalog is authored
// in this file and reviewed as source, never mutated at runtime.
//
// DomainForge 0.16.0 resolves operations through the Application Contract
// library boundary, not through the CLI; see validation/limitations.md L4.
// ---------------------------------------------------------------------------

record GetCanonicalJourneyInput {
    journey_id: string (pattern JourneyId)
}

record GetCanonicalJourneyOutput {
    journey_id: string (pattern JourneyId)
    slug: string (min_length 8, max_length 64)
    title: string (min_length 12, max_length 80)
    intention: string (min_length 60)
    completion_condition: string (min_length 100)
    next_decisions: string (min_length 60)
    observed_story_count: int (min 1, max 128)
    interface_binding_count: int (min 1, max 128)
}

operation get_canonical_journey {
    intent "return the canonical interaction contract for one journey so any interface can project it without redefining its meaning"
    direction inbound
    actor anonymous
    access public
    input GetCanonicalJourneyInput
    output GetCanonicalJourneyOutput
    state CanonicalJourney
    effect reads CanonicalJourney
    transaction read_only
    failure invalid_journey_id for input_validation "journey_id is not a CJ01-CJ12 identifier"
    failure canonical_journey_not_found for missing_state "no canonical journey carries that identifier"
    idempotency inherent
    concurrency read_snapshot
    evidence operation_trace
    lifecycle synchronous_request_response
}

// ---------------------------------------------------------------------------
// Graph invariants
//
// These policies quantify over concrete entity instances, which DomainForge
// 0.15.0 could not do. Breaking any count below fails `domainforge validate`;
// validation/semantic-teeth.md records the proof for each one.
// ---------------------------------------------------------------------------

policy exactly_one_product_purpose
    @rationale "One product purpose is declared. A second would create a competing statement of what SEA Forge is for inside the model that is supposed to settle it."
    as: count(i in entity_instances where i.entity = "ProductPurpose": i.purpose_id) = 1

policy twelve_canonical_journeys
    @rationale "Exactly twelve canonical journeys exist. A thirteenth journey, or a deleted one, fails validation."
    as: count(i in entity_instances where i.entity = "CanonicalJourney": i.journey_id) = 12

policy all_observed_stories_accounted
    @rationale "The per-journey story counts still account for all 128 observed stories in the governed Workbench UX epic."
    as: sum(i in entity_instances where i.entity = "CanonicalJourney": i.observed_story_count) = 128

policy specified_stories_reconcile
    @rationale "The specified-maturity distribution still matches the reconciled coverage report."
    as: sum(i in entity_instances where i.entity = "CanonicalJourney": i.specified_story_count) = 13

policy implemented_stories_reconcile
    @rationale "The implemented-maturity distribution still matches the reconciled coverage report."
    as: sum(i in entity_instances where i.entity = "CanonicalJourney": i.implemented_story_count) = 6

policy exercised_stories_reconcile
    @rationale "The exercised-maturity distribution still matches the reconciled coverage report."
    as: sum(i in entity_instances where i.entity = "CanonicalJourney": i.exercised_story_count) = 85

policy evidenced_stories_reconcile
    @rationale "The evidenced-maturity distribution still matches the reconciled coverage report."
    as: sum(i in entity_instances where i.entity = "CanonicalJourney": i.evidenced_story_count) = 24

policy eight_interaction_steps
    @rationale "The reusable interaction skeleton has exactly eight ordered phases."
    as: count(i in entity_instances where i.entity = "JourneyStep": i.step_id) = 8

policy interaction_step_ordinals_complete
    @rationale "The eight step ordinals are exactly 1 through 8, so no phase is duplicated or missing from the order."
    as: sum(i in entity_instances where i.entity = "JourneyStep": i.ordinal) = 36

policy eight_canonicalization_classifications
    @rationale "The closed classification vocabulary still has exactly eight values."
    as: count(i in entity_instances where i.entity = "CanonicalizationClassification": i.classification_id) = 8

policy classification_rows_account_for_all_stories
    @rationale "The classification census still totals the 128 observed stories."
    as: sum(i in entity_instances where i.entity = "CanonicalizationClassification": i.observed_rows) = 128

policy eleven_variation_dimensions
    @rationale "Eleven recurring variation dimensions describe how observed stories vary."
    as: count(i in entity_instances where i.entity = "VariationDimension": i.dimension_id) = 11

policy thirty_eight_interface_surfaces
    @rationale "Thirty-eight interface surfaces are bound: 11 Workbench route groups, 11 SFWP method families, 11 CLI families, and 5 agent surfaces."
    as: count(i in entity_instances where i.entity = "InterfaceSurface": i.surface_id) = 38

policy interface_bindings_reconcile
    @rationale "Every journey's declared binding count sums to the number of declared bindings. Combined with the min 1 field constraint, this proves that every canonical journey is projected by at least one interface surface and that no binding is orphaned."
    as: sum(i in entity_instances where i.entity = "CanonicalJourney": i.interface_binding_count) = count(i in entity_instances where i.entity = "InterfaceBinding": i.binding_id)

policy has_interaction_flow
    @rationale "The interaction skeleton and the twelve journey transitions are present as flows."
    as: count(flows) > 0

policy has_governed_evidence_resource
    @rationale "Governed evidence remains a declared resource of the interaction domain."
    as: exists r in resources: (r.name = "GovernedEvidence")

