{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sea-forge:fde:case-record-append:v1",
  "title": "case.record.append v1",
  "description": "The one Casework write verb for Field Case records: request {kind, payload, idempotency_key}, success response, refusal. At this stage the registry holds two kinds, episode.frozen and episode.settled; WP-20 adds the other four and the read verbs on this contract. The case is addressed by the SFWP route, and every payload's episode_ref must carry that case_id. The schema fixes shape; the refusals that depend on ledger state (I-1, I-2, I-3, idempotency) are specified in the README and exercised by scenario fixtures.",
  "oneOf": [
    { "$ref": "#/$defs/Request" },
    { "$ref": "#/$defs/Response" },
    { "$ref": "#/$defs/Error" }
  ],
  "$defs": {
    "episode_ref": { "$ref": "urn:sea-forge:fde:frozen-reference:v1#/$defs/episode_ref" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1 },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload", "idempotency_key"],
      "properties": {
        "kind": { "enum": ["episode.frozen", "episode.settled"] },
        "payload": { "type": "object" },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[^\\s]{1,256}$",
          "description": "The cross-system record key (system, record_id) written as one token. A replay (same key, same body) returns the original response with replayed=true; the same key with a different body is IDEMPOTENCY_CONFLICT."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "episode.frozen" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/EpisodeFrozenPayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "episode.settled" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/EpisodeSettledPayload" } } }
        }
      ]
    },
    "EpisodeFrozenPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_ref", "reference", "digest", "realitytrace_refs"],
      "properties": {
        "episode_ref": { "$ref": "#/$defs/episode_ref" },
        "reference": {
          "description": "The canonical frozen reference. Its episode_ref equals this payload's.",
          "$ref": "urn:sea-forge:fde:frozen-reference:v1"
        },
        "digest": { "$ref": "#/$defs/sha256", "description": "SHA-256 over RFC 8785 canonical JSON of reference.body; equals the digest inside episode_ref." },
        "realitytrace_refs": {
          "description": "RealityTrace records written first (freeze order step 1, RD-12).",
          "type": "object",
          "additionalProperties": false,
          "required": ["plan_id", "question_ids", "threshold_ids"],
          "properties": {
            "plan_id": { "$ref": "#/$defs/text" },
            "question_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^question:.+$" } },
            "threshold_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^threshold:.+$" } }
          }
        }
      }
    },
    "EpisodeSettledPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_ref", "result", "reliability", "independence", "settlement_ref"],
      "properties": {
        "episode_ref": { "$ref": "#/$defs/episode_ref" },
        "result": { "enum": ["S", "F", "U", "C"], "description": "Epistemic result: established success, established failure, unresolved, contradictory." },
        "reliability": {
          "description": "Settlement reliability, kept apart from the result. Only the dimensions the evaluation contract sets thresholds for are present; {} is valid.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "T": { "$ref": "#/$defs/text" },
            "A": { "$ref": "#/$defs/text" },
            "I": { "$ref": "#/$defs/text" },
            "K": { "$ref": "#/$defs/text" },
            "D": { "$ref": "#/$defs/text" },
            "X": { "$ref": "#/$defs/text" },
            "N": { "$ref": "#/$defs/text" }
          }
        },
        "independence": {
          "description": "Source independence, kept apart from the result.",
          "type": "object",
          "additionalProperties": false,
          "required": ["independent_source_count", "verifier_context"],
          "properties": {
            "independent_source_count": { "type": "integer", "minimum": 0 },
            "verifier_context": { "enum": ["fresh", "shared", "unknown"] }
          }
        },
        "settlement_ref": { "$ref": "#/$defs/text", "description": "RealityTrace settlement id (settlement:...)." }
      }
    },
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "kind", "record_id", "episode_key", "replayed"],
      "properties": {
        "outcome": { "const": "recorded" },
        "kind": { "enum": ["episode.frozen", "episode.settled"] },
        "record_id": { "$ref": "#/$defs/text", "description": "Id of the case record, assigned by the case keeper." },
        "episode_key": {
          "type": "object",
          "additionalProperties": false,
          "required": ["case_id", "plan_item_id", "n"],
          "properties": {
            "case_id": { "$ref": "#/$defs/text" },
            "plan_item_id": { "$ref": "#/$defs/text" },
            "n": { "type": "integer", "minimum": 1 }
          }
        },
        "replayed": { "type": "boolean", "description": "true when this is the original response to an earlier request with the same idempotency_key and body." }
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "code", "message"],
      "properties": {
        "outcome": { "const": "refused" },
        "code": {
          "enum": [
            "SCHEMA_INVALID",
            "KIND_UNKNOWN",
            "IDEMPOTENCY_CONFLICT",
            "EPISODE_REF_DIGEST_MISMATCH",
            "RESULT_INVALID",
            "FREEZE_KEY_EXISTS",
            "FREEZE_MISSING",
            "FREEZE_INCOMPLETE",
            "SELF_SETTLEMENT_REFUSED"
          ]
        },
        "message": { "$ref": "#/$defs/text" },
        "invariant": { "enum": ["I-1", "I-2", "I-3"], "description": "Present exactly for the codes that enforce an invariant." }
      },
      "allOf": [
        {
          "if": { "properties": { "code": { "const": "FREEZE_KEY_EXISTS" } }, "required": ["code"] },
          "then": { "required": ["invariant"], "properties": { "invariant": { "const": "I-3" } } }
        },
        {
          "if": { "properties": { "code": { "enum": ["FREEZE_MISSING", "FREEZE_INCOMPLETE"] } }, "required": ["code"] },
          "then": { "required": ["invariant"], "properties": { "invariant": { "const": "I-1" } } }
        },
        {
          "if": { "properties": { "code": { "const": "SELF_SETTLEMENT_REFUSED" } }, "required": ["code"] },
          "then": { "required": ["invariant"], "properties": { "invariant": { "const": "I-2" } } }
        },
        {
          "if": {
            "properties": {
              "code": { "enum": ["SCHEMA_INVALID", "KIND_UNKNOWN", "IDEMPOTENCY_CONFLICT", "EPISODE_REF_DIGEST_MISMATCH", "RESULT_INVALID"] }
            },
            "required": ["code"]
          },
          "then": { "not": { "required": ["invariant"] } }
        }
      ]
    }
  }
}
