{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sea-forge:fde:delegation-link:v1",
  "title": "Delegation link v1",
  "description": "Closes the I-2 residual 'delegate then settle' (S1 finding F7) and the executor-set hole found in review: item_execute and case_advance execute under the request actor and write no link. The executor set of an episode is the union of the actor AND on_behalf_of principals on EVERY run record carrying the episode's episode_ref, plus the delegates of its links, plus the transitive closure of their delegators. The case keeper writes a Link for every accepted delegate of a Field Case episode, BEFORE the run starts (link.issued_at is not after run.started_at), and a RunRecord for every execution of any verb. Settlement is refused with SELF_SETTLEMENT_REFUSED (the code case-record-append.v1 already uses for I-2) when the settling principal is in that set. A run with no resolvable actor, a delegated run with no link record, or a link written after its run is DELEGATION_LINK_INVALID (fail closed). Principals are compared on canonical actor strings: trimmed, case-folded, as crates/sea-forge-server/src/sfwp/case_records.rs canonical_actor does; until S3 two unrelated ids of one human are indistinguishable (residual).",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "episode_ref": {
      "$ref": "urn:sea-forge:fde:frozen-reference:v1#/$defs/episode_ref"
    },
    "principal": {
      "type": "string",
      "pattern": "^[^\\s]{1,256}$",
      "description": "A SEA-Forge actor identity (S1-S2) or, from S3, the shared identity principal. Compared after canonicalisation (trim, case-fold), never by raw string.",
      "maxLength": 4096
    },
    "Link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_id",
        "case_id",
        "episode_ref",
        "assignment_id",
        "delegator",
        "gateway_actor",
        "delegate",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "link_id": {
          "$ref": "#/$defs/text"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[^\\s:@]{1,128}$",
          "maxLength": 4096
        },
        "episode_ref": {
          "$ref": "#/$defs/episode_ref"
        },
        "assignment_id": {
          "$ref": "urn:sea-forge:fde:assignment:v1#/$defs/assignment_id"
        },
        "delegator": {
          "$ref": "#/$defs/principal",
          "description": "The principal on whose authority the run was delegated: on_behalf_of when a gateway sent the request, else the request actor."
        },
        "gateway_actor": {
          "oneOf": [
            {
              "$ref": "#/$defs/principal"
            },
            {
              "type": "null"
            }
          ],
          "description": "The gateway actor that sent the request on behalf of delegator; null when no gateway was involved. Both are recorded (M7)."
        },
        "delegate": {
          "$ref": "#/$defs/principal",
          "description": "The actor identity the agent run executes as."
        },
        "issued_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "maxLength": 4096
        },
        "expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "description": "After this time no run starts or resumes under the link; settlement checks still use it (a link is never deleted).",
          "maxLength": 4096
        }
      }
    },
    "RunRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "case_id",
        "episode_ref",
        "verb",
        "role",
        "actor",
        "on_behalf_of",
        "delegated",
        "link_id",
        "workspace_ref",
        "started_at"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/text"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[^\\s:@]{1,128}$",
          "maxLength": 4096
        },
        "episode_ref": {
          "$ref": "#/$defs/episode_ref"
        },
        "verb": {
          "enum": [
            "item_execute",
            "case_advance",
            "delegate",
            "human_task_complete"
          ]
        },
        "role": {
          "enum": [
            "executor",
            "verifier"
          ]
        },
        "actor": {
          "oneOf": [
            {
              "$ref": "#/$defs/principal"
            },
            {
              "type": "null"
            }
          ],
          "description": "The authenticated actor the run executed under. null means the actor could not be resolved: settlement of the episode is refused (DELEGATION_LINK_INVALID)."
        },
        "on_behalf_of": {
          "oneOf": [
            {
              "$ref": "#/$defs/principal"
            },
            {
              "type": "null"
            }
          ]
        },
        "delegated": {
          "type": "boolean"
        },
        "link_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required for a delegated run (the Link written before it started); null otherwise."
        },
        "workspace_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Identity of the workspace or cell the run used; freshness of a verifier context is derived from it."
        },
        "started_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
          "maxLength": 4096
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "delegated": {
                "const": true
              }
            },
            "required": [
              "delegated"
            ]
          },
          "then": {
            "properties": {
              "link_id": {
                "type": "string",
                "maxLength": 4096
              }
            }
          },
          "else": {
            "properties": {
              "link_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_ref",
        "settling_principal",
        "result",
        "declared_verifier_context",
        "settler_root",
        "links",
        "runs"
      ],
      "properties": {
        "episode_ref": {
          "$ref": "#/$defs/episode_ref"
        },
        "settling_principal": {
          "$ref": "#/$defs/principal"
        },
        "result": {
          "enum": [
            "S",
            "F",
            "U",
            "C"
          ]
        },
        "declared_verifier_context": {
          "enum": [
            "fresh",
            "shared",
            "unknown"
          ],
          "description": "independence.verifier_context of the episode.settled payload: informational, must equal the context the server derives from the run records."
        },
        "settler_root": {
          "oneOf": [
            {
              "$ref": "#/$defs/principal"
            },
            {
              "type": "null"
            }
          ],
          "description": "Root of the settler's own delegation chain (server-derived); null when the settler is not delegated by anyone."
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Link"
          },
          "maxItems": 256
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunRecord"
          },
          "maxItems": 256
        }
      },
      "description": "The input of the I-2 and verifier-context checks, as WP-21 assembles it from the ledger."
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "code",
        "message"
      ],
      "properties": {
        "outcome": {
          "const": "refused"
        },
        "code": {
          "enum": [
            "SELF_SETTLEMENT_REFUSED",
            "DELEGATION_LINK_INVALID",
            "VERIFIER_CONTEXT_MISMATCH"
          ]
        },
        "message": {
          "$ref": "#/$defs/text"
        },
        "invariant": {
          "const": "I-2"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "VERIFIER_CONTEXT_MISMATCH"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "invariant"
              ]
            }
          },
          "else": {
            "required": [
              "invariant"
            ]
          }
        }
      ],
      "x-decision": "WP-21a D40: VERIFIER_CONTEXT_MISMATCH carries no invariant (case-record-append.v2 section 6 error table); SELF_SETTLEMENT_REFUSED and DELEGATION_LINK_INVALID carry I-2"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Link"
    },
    {
      "$ref": "#/$defs/RunRecord"
    },
    {
      "$ref": "#/$defs/Settlement"
    },
    {
      "$ref": "#/$defs/Error"
    }
  ]
}
