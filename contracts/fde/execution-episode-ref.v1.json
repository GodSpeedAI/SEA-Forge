{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sea-forge:fde:execution-episode-ref:v1",
  "title": "Execution episode_ref v1",
  "description": "Closes S1 finding F1(b), I-1 freeze before move: the field episode_ref on the three execution entry points item_execute, case_advance and agent_run.delegate (wire verb delegate). For a case whose template_ref is fde.field_case@1 a request without episode_ref, or whose episode has no COMPLETE freeze (RealityTrace plan, question and threshold, the episode.frozen record, a verified anchor), is refused with FREEZE_MISSING or FREEZE_INCOMPLETE before any side effect; other cases are unaffected. The request shapes below are the existing SFWP shapes (apps/godspeed-casework-go/internal/adapters/sfwp/frame.go, crates/sea-forge-server Request::Delegate) plus the new fields; the existing response of an accepted request is unchanged. Shape only: the rule table and the scenarios in the README and fixtures are implemented by WP-21.",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "EpisodeRefField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "plan_item_id",
        "n",
        "kind"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[^\\s:@]{1,128}$",
          "maxLength": 4096
        },
        "plan_item_id": {
          "type": "string",
          "pattern": "^[^\\s:@]{1,128}$",
          "maxLength": 4096
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "evaluated",
            "exploratory"
          ]
        }
      },
      "description": "Names the episode by key; the case keeper resolves the frozen episode_ref (with digest) from the ledger. The kind is checked against the frozen kind, never trusted (KIND_IMMUTABLE)."
    },
    "ItemExecuteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verb",
        "case_id",
        "item_id",
        "request_id"
      ],
      "properties": {
        "verb": {
          "const": "item_execute"
        },
        "case_id": {
          "$ref": "#/$defs/text"
        },
        "item_id": {
          "$ref": "#/$defs/text"
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "role"
          ],
          "properties": {
            "actor_id": {
              "$ref": "#/$defs/text"
            },
            "role": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "on_behalf_of": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "role"
          ],
          "properties": {
            "actor_id": {
              "$ref": "#/$defs/text"
            },
            "role": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "request_id": {
          "$ref": "#/$defs/text"
        },
        "policy": {
          "$ref": "#/$defs/text"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        },
        "episode_ref": {
          "$ref": "#/$defs/EpisodeRefField"
        }
      }
    },
    "CaseAdvanceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verb",
        "case_id",
        "request_id"
      ],
      "properties": {
        "verb": {
          "const": "case_advance"
        },
        "case_id": {
          "$ref": "#/$defs/text"
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "role"
          ],
          "properties": {
            "actor_id": {
              "$ref": "#/$defs/text"
            },
            "role": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "on_behalf_of": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "role"
          ],
          "properties": {
            "actor_id": {
              "$ref": "#/$defs/text"
            },
            "role": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "request_id": {
          "$ref": "#/$defs/text"
        },
        "policy": {
          "$ref": "#/$defs/text"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        },
        "episode_ref": {
          "$ref": "#/$defs/EpisodeRefField"
        },
        "transition_items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "transition",
              "transition_only"
            ],
            "properties": {
              "item_id": {
                "$ref": "#/$defs/text"
              },
              "transition": {
                "enum": [
                  "skip",
                  "complete"
                ]
              },
              "transition_only": {
                "const": true
              }
            }
          },
          "description": "On a Field Case an advance must either carry episode_ref (it then executes only that episode's item) or state, per affected item, transition_only: true. The server refuses (TRANSITION_ONLY_INVALID) a transition_only entry for an item that has an execution step."
        }
      },
      "description": "With episode_ref, a Field Case advance executes only the enabled item of that episode's plan_item_id. Without it, transition_items is required; neither is FREEZE_MISSING."
    },
    "HumanTaskCompleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verb",
        "case_id",
        "item_id",
        "justification",
        "request_id"
      ],
      "properties": {
        "verb": {
          "const": "human_task_complete"
        },
        "case_id": {
          "$ref": "#/$defs/text"
        },
        "item_id": {
          "$ref": "#/$defs/text"
        },
        "justification": {
          "$ref": "#/$defs/text"
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "role"
          ],
          "properties": {
            "actor_id": {
              "$ref": "#/$defs/text"
            },
            "role": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "on_behalf_of": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "role"
          ],
          "properties": {
            "actor_id": {
              "$ref": "#/$defs/text"
            },
            "role": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "request_id": {
          "$ref": "#/$defs/text"
        },
        "policy": {
          "$ref": "#/$defs/text"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "Existing verb; listed because completing the last item is a path to a terminal state and is gated by CLOSE_DISPOSITION_REQUIRED like every other path (R11)."
    },
    "DelegateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verb",
        "case_id",
        "endpoint",
        "instruction",
        "max_turns"
      ],
      "properties": {
        "verb": {
          "const": "delegate",
          "description": "Wire verb of the logical operation agent_run.delegate."
        },
        "case_id": {
          "$ref": "#/$defs/text",
          "description": "The case the run belongs to. REQUIRED (review C1): the case template is resolved by the server from this id, never from the presence of episode_ref; I-1 is checked on this server-resolved identity, not on a caller tag (E section 3, G NT-32). A delegate whose case_id does not resolve is refused (CASE_UNRESOLVED)."
        },
        "endpoint": {
          "$ref": "#/$defs/text"
        },
        "instruction": {
          "$ref": "#/$defs/text"
        },
        "run_id": {
          "$ref": "#/$defs/text"
        },
        "model": {
          "$ref": "#/$defs/text"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "token_budget": {
          "type": "integer",
          "minimum": 1
        },
        "criteria": {
          "type": "object",
          "description": "The existing SettlementCriteria value of the server; not defined here."
        },
        "entity": {
          "$ref": "#/$defs/text"
        },
        "process": {
          "$ref": "#/$defs/text"
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "role"
          ],
          "properties": {
            "actor_id": {
              "$ref": "#/$defs/text"
            },
            "role": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "on_behalf_of": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "role"
          ],
          "properties": {
            "actor_id": {
              "$ref": "#/$defs/text"
            },
            "role": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "request_id": {
          "$ref": "#/$defs/text"
        },
        "policy": {
          "$ref": "#/$defs/text"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        },
        "episode_ref": {
          "$ref": "#/$defs/EpisodeRefField"
        },
        "assignment_id": {
          "$ref": "urn:sea-forge:fde:assignment:v1#/$defs/assignment_id"
        },
        "assignment": {
          "$ref": "urn:sea-forge:fde:assignment-binding:v1#/$defs/AssignmentApproval",
          "description": "The approved assignment (WP-23, assignment-binding.v1): explicit domain_meaning and the five SOP 5.1 currency ceilings from the approval path. REQUIRED on a Field Case delegate, new or resume; the response of an accepted request is unchanged. adoptable_problem is never sent: the frozen case supplies it, and instruction already travels on this request."
        }
      },
      "description": "case_id is required (the wire verb had none before this contract). On a Field Case, episode_ref and assignment_id are required; episode_ref.case_id equals case_id; the assignment id's case, step and n equal the episode's; k is new for a new delegation (ASSIGNMENT_ID_INVALID) or the id of an interrupted assignment whose link has not expired for a resume (ASSIGNMENT_LINK_EXPIRED otherwise). Since assignment-binding.v1 (WP-23) the delegate also carries `assignment`, the approved Brief and Budget values; the admitted run records them as the assignment binding, and a resume must match the recorded binding (assignment-binding.v1 Error codes)."
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "code",
        "message"
      ],
      "properties": {
        "outcome": {
          "const": "refused"
        },
        "code": {
          "enum": [
            "EPISODE_SUPERSEDED",
            "EPISODE_SETTLED",
            "CASE_CLOSED",
            "CASE_UNRESOLVED",
            "TRANSITION_ONLY_INVALID",
            "ASSIGNMENT_LINK_EXPIRED",
            "FREEZE_MISSING",
            "FREEZE_INCOMPLETE",
            "KIND_IMMUTABLE",
            "SCHEMA_INVALID",
            "CASE_SUSPENDED",
            "AUTHORITY_DENIED",
            "ANCHOR_PUBLISHER_INVALID",
            "MODEL_ANCHOR_LATE",
            "CLOSE_DISPOSITION_REQUIRED",
            "ASSIGNMENT_ID_INVALID"
          ]
        },
        "message": {
          "$ref": "#/$defs/text"
        },
        "invariant": {
          "enum": [
            "I-1",
            "I-3"
          ]
        },
        "no_side_effect": {
          "const": true,
          "description": "Always true: a gate refusal happens before any run, spend or record."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "FREEZE_MISSING",
                  "FREEZE_INCOMPLETE"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "invariant",
              "no_side_effect"
            ],
            "properties": {
              "invariant": {
                "const": "I-1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "KIND_IMMUTABLE"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "invariant",
              "no_side_effect"
            ],
            "properties": {
              "invariant": {
                "const": "I-3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "EPISODE_SUPERSEDED",
                  "EPISODE_SETTLED",
                  "CASE_CLOSED",
                  "CASE_UNRESOLVED",
                  "TRANSITION_ONLY_INVALID",
                  "ASSIGNMENT_LINK_EXPIRED",
                  "SCHEMA_INVALID",
                  "CASE_SUSPENDED",
                  "AUTHORITY_DENIED",
                  "ANCHOR_PUBLISHER_INVALID",
                  "MODEL_ANCHOR_LATE",
                  "CLOSE_DISPOSITION_REQUIRED",
                  "ASSIGNMENT_ID_INVALID"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "not": {
              "required": [
                "invariant"
              ]
            },
            "required": [
              "no_side_effect"
            ]
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ItemExecuteRequest"
    },
    {
      "$ref": "#/$defs/CaseAdvanceRequest"
    },
    {
      "$ref": "#/$defs/HumanTaskCompleteRequest"
    },
    {
      "$ref": "#/$defs/DelegateRequest"
    },
    {
      "$ref": "#/$defs/Error"
    }
  ]
}
