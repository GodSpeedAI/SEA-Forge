{
  "id": "case-suspended-refuses-case-level-revise-disposition",
  "rule": "lifecycle",
  "nt": "NT-22",
  "dialect": "v2",
  "ledger_before": [
    {
      "kind": "disposition.recorded",
      "level": "case",
      "disposition": "suspend"
    }
  ],
  "request": {
    "contract": "fde.case-record-append@2",
    "kind": "disposition.recorded",
    "payload": {
      "level": "case",
      "disposition": "revise",
      "rationale": "settled S, outcome accepted",
      "approval_ref": "approval:appr-0043"
    },
    "idempotency_key": "operator/rec-0132"
  },
  "expect": {
    "outcome": "refused",
    "code": "CASE_SUSPENDED",
    "message": "case is suspended"
  }
}
