{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecordDigest",
  "description": "A single `{ref, expected_digest}` precondition entry.",
  "type": "object",
  "properties": {
    "expected_digest": {
      "description": "The sha256 digest the caller expects the referenced record to have.",
      "type": "string"
    },
    "ref": {
      "description": "Opaque record reference (e.g. `case:<case_id>`, `approval:<id>`).",
      "type": "string"
    }
  },
  "required": [
    "ref",
    "expected_digest"
  ]
}
