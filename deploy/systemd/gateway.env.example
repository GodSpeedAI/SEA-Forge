# /etc/sea-forge/gateway.env  (0640 root:sea-forge) - holds secrets, never commit real values.
GODSPEED_CONFIG=/etc/sea-forge/gateway.json
GODSPEED_CELL_ROOT=/var/lib/sea-forge/cell
# Loopback-only, unauthenticated Prometheus text endpoint (http://127.0.0.1:9109/metrics).
# Omit to disable. Non-loopback addresses are refused at startup.
GODSPEED_METRICS_ADDR=127.0.0.1:9109
# Secrets referenced from gateway.json as "env:NAME" (OIDC example):
# OIDC_CLIENT_SECRET=...
