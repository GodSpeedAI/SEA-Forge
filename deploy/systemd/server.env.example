# /etc/sea-forge/server.env  (0640 root:sea-forge)
# The cell root holds every durable record. The socket lives in the runtime dir so a short path
# is guaranteed (Unix socket paths are limited to ~100 bytes) and a tmpfs wipe on reboot removes
# any stale socket. The server still takes its records from the cell root.
SEA_FORGE_ROOT=/var/lib/sea-forge/cell
SEA_FORGE_SOCKET=/run/sea-forge/server.sock
