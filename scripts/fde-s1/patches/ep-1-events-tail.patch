+/// `events.get_range` with `tail: true` returns the most recent events in
+/// stream order, bounded by `limit`; an explicit range is unchanged; a tail
+/// read with a cursor is refused.
+#[tokio::test(flavor = "multi_thread")]
+async fn events_get_range_tail_returns_the_latest_events_in_stream_order() {
+    let (address, listener) = hung_endpoint().await;
+    let (root, socket) = boot_with_hung_endpoint(address.port()).await;
+    fs::write(
+        root.path().join("server.yaml"),
+        "max_concurrent_runs: [oops\n",
+    )
+    .unwrap();
+    for n in 0..3 {
+        let _ = round_trip(
+            &socket,
+            json!({"verb": "submit", "actor": {"actor_id": "operator_local", "role": "operator"}, "intent": "anything", "policy": "policy.yaml", "request_id": format!("req-tail-{n}")}),
+            Duration::from_secs(30),
+        )
+        .await;
+    }
+    let all = round_trip(&socket, json!({"verb": "events_get_range"}), Duration::from_secs(10)).await;
+    let explicit = round_trip(&socket, json!({"verb": "events_get_range", "tail": false}), Duration::from_secs(10)).await;
+    assert_eq!(all, explicit, "an explicit range response is unchanged by the new selector");
+    let frames = all["events"].as_array().unwrap();
+    assert!(frames.len() >= 2, "need at least two events: {all}");
+    let tail_one = round_trip(&socket, json!({"verb": "events_get_range", "tail": true, "limit": 1}), Duration::from_secs(10)).await;
+    assert_eq!(tail_one["events"], json!([frames[frames.len() - 1]]));
+    let tail_two = round_trip(&socket, json!({"verb": "events_get_range", "tail": true, "limit": 2}), Duration::from_secs(10)).await;
+    assert_eq!(tail_two["events"], json!(frames[frames.len() - 2..]), "stream order, not reversed");
+    let capped = round_trip(&socket, json!({"verb": "events_get_range", "tail": true, "limit": 100000}), Duration::from_secs(10)).await;
+    assert!(capped["events"].as_array().unwrap().len() <= 500, "EVENTS_REPLAY_CAP bounds the page");
+    let cursor = frames[0]["cursor"].as_str().or_else(|| frames[0]["event_id"].as_str()).unwrap_or("x");
+    let refused = round_trip(&socket, json!({"verb": "events_get_range", "tail": true, "from_cursor": cursor}), Duration::from_secs(10)).await;
+    assert!(refused["error"].as_str().unwrap_or("").contains("events_tail_with_cursor"), "{refused}");
+    listener.abort();
+}
