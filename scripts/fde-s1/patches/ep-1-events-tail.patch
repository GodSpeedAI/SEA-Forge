+/// Server-side tail read for `events.get_range` (`tail: true`): the most recent
+/// `limit` event frames (default and maximum [`EVENTS_REPLAY_CAP`]) in stream
+/// order. Cursors are not accepted together with `tail`: a tail read is
+/// anchored at the head, so a cursor would be ambiguous.
+pub fn get_tail(ledger: &LedgerStream, limit: Option<u32>) -> Result<Vec<EventFrame>, ForgeError> {
+    let entries = ledger.read_entries()?;
+    let cap = limit
+        .map(|value| (value as usize).min(EVENTS_REPLAY_CAP))
+        .unwrap_or(EVENTS_REPLAY_CAP);
+    let mut frames: Vec<EventFrame> = entries
+        .iter()
+        .rev()
+        .filter(|entry| entry.record_kind == EVENT_RECORD_KIND)
+        .take(cap)
+        .map(frame_from_entry)
+        .collect();
+    frames.reverse();
+    Ok(frames)
+}
