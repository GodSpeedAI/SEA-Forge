{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaseListResult",
  "description": "`case.list` result body.",
  "type": "object",
  "properties": {
    "cases": {
      "description": "Newest first. Empty is an honest answer for a cell with no cases.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CaseSummary"
      }
    },
    "unreadable": {
      "description": "Case directories that exist but could not be read as a `Case` record.\nReported rather than silently dropped: a case whose record is\nunreadable is an integrity signal, not an absence.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "cases"
  ],
  "$defs": {
    "CaseSummary": {
      "description": "One row of `case.list`.",
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "case_state": {
          "type": "string"
        },
        "close_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "closed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "run_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "summary": {
          "description": "The operator-facing intent summary committed with the case.",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_state",
        "summary",
        "created_at",
        "run_count"
      ]
    }
  }
}
