{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaseOverview",
  "description": "`case.get_overview` result body.",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "case_state": {
      "type": "string"
    },
    "close_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "item_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "plan_ref": {
      "description": "The plan this case was committed from, when `plan.json` is readable.",
      "type": [
        "string",
        "null"
      ]
    },
    "run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settlements": {
      "description": "Settlement records found for this case's runs. Empty means nothing has\nsettled yet — never that the work failed.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/RunSettlement"
      }
    },
    "stages": {
      "description": "Stage item ids, in plan order.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "template_ref": {
      "description": "`name@version` of the originating template, when the plan recorded one.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "case_id",
    "case_state",
    "summary",
    "created_at",
    "item_count",
    "run_ids"
  ],
  "$defs": {
    "RunSettlement": {
      "description": "A settlement record linked to a run, projected for the overview.",
      "type": "object",
      "properties": {
        "basis": {
          "description": "The evidence basis the settlement cited.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "review_required": {
          "type": "boolean"
        },
        "run_id": {
          "type": "string"
        },
        "settled_at": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SettlementStanding"
        }
      },
      "required": [
        "run_id",
        "status",
        "review_required",
        "settled_at"
      ]
    },
    "SettlementStanding": {
      "description": "Whether a *governed settlement* has been recorded for the item. Distinct\nfrom execution: work can execute perfectly and settle as rejected.",
      "oneOf": [
        {
          "description": "No settlement record exists for this item yet.",
          "type": "string",
          "const": "unsettled"
        },
        {
          "description": "A settlement record accepted the work.",
          "type": "string",
          "const": "accepted"
        },
        {
          "description": "A settlement record rejected the work.",
          "type": "string",
          "const": "rejected"
        },
        {
          "description": "A settlement record escalated the decision to a human.",
          "type": "string",
          "const": "escalated"
        }
      ]
    }
  }
}
