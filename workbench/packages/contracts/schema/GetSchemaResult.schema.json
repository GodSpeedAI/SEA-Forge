{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GetSchemaResult",
  "description": "`system.get_schema` result body.",
  "type": "object",
  "properties": {
    "schemas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SchemaRef"
      }
    }
  },
  "required": [
    "schemas"
  ],
  "$defs": {
    "SchemaRef": {
      "description": "A schema reference the generator emits (relative path under the contracts\nschema directory).",
      "type": "object",
      "properties": {
        "name": {
          "description": "The type/shape this schema describes.",
          "type": "string"
        },
        "path": {
          "description": "Relative path to the generated JSON Schema file.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ]
    }
  }
}
