{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RejectedAsStale",
  "description": "The structured `rejected_as_stale` response body. No side effect has been\nperformed when this is returned.",
  "type": "object",
  "properties": {
    "changed_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChangedRecord"
      }
    },
    "code": {
      "description": "Always `\"precondition_failed\"`.",
      "type": "string"
    },
    "next_actions": {
      "description": "Repair guidance the client should follow before any retry.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "description": "Always `\"rejected_as_stale\"`.",
      "type": "string"
    }
  },
  "required": [
    "outcome",
    "code",
    "changed_records",
    "next_actions"
  ],
  "$defs": {
    "ChangedRecord": {
      "description": "A record whose current digest diverged from the caller's expectation.",
      "type": "object",
      "properties": {
        "current_digest": {
          "description": "The record's actual current digest, or `null` if it no longer exists.",
          "type": [
            "string",
            "null"
          ]
        },
        "expected_digest": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "ref",
        "expected_digest"
      ]
    }
  }
}
